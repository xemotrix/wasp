include "src/stdlib.wasp"
include "src/strings.wasp"
include "src/utils.wasp"
include "src/mem.wasp"

const SYS_GETRANDOM:int = 318;

fn draw_table() {
    i:int = 0;
    while i < SIZEY {
        println(BOARD[i]);
        i++;
    }
}

fn alive(y:int, x:int) bool {
    if y < 0 || y >= SIZEY { return false; }
    if x < 0 || x >= SIZEX { return false; }
    return BOARD[y].data[x] == '#';
}

fn alive_neigs(y:int, x:int) int {
    count:int = 0;
    if alive(y-1, x-1) { count++; }
    if alive(y-1, x)   { count++; }
    if alive(y-1, x+1) { count++; }
    if alive(y, x-1)   { count++; }
    if alive(y, x+1)   { count++; }
    if alive(y+1, x-1) { count++; }
    if alive(y+1, x)   { count++; }
    if alive(y+1, x+1) { count++; }
    return count;
}

fn iter() {
    nextb:*String = init_board();
    i:int = 0;
    while i < SIZEY {
        j:int = 0;
        while j < SIZEX {
            aneigs:int = alive_neigs(i,j);
            is_alive:bool = alive(i,j);
            if is_alive {
                if aneigs < 2 { nextb[i].data[j] = '.'; } 
                if aneigs >= 2 && aneigs <= 3 { nextb[i].data[j] = '#'; } 
                if aneigs > 3 { nextb[i].data[j] = '.'; } 
            }
            if !is_alive {
                if aneigs == 3 { nextb[i].data[j] = '#'; } 
                if aneigs != 3 { nextb[i].data[j] = '.'; } 
            }
            j++;
        }
        i++;
    }
    mfree(BOARD); 
    BOARD = nextb;
}

fn init_board() *String {
    board:*String = malloc(SIZEY*@size(String));
    i:int = 0;
    while i < SIZEY {
        board[i] = string_new(malloc(SIZEX*@size(char)), SIZEX);
        j:int = 0;
        while j < SIZEX {
            board[i].data[j] = '.';
            rand:int = 0;
            @syscall(SYS_GETRANDOM, &rand, 8, 0);
            if rand % 7 == 0 {
                board[i].data[j] = '#';
            }
            j++;
        }
        i++;
    }
    return board;
}

var BOARD:*String = 0;
var SIZEY:int = 50;
var SIZEX:int = 100;

fn main() int {
    BOARD = init_board();
    draw_table();
    while true {
        println("=====================");
        iter();
        draw_table();
    }
    return 0;
}
