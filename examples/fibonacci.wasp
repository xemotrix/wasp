include "src/stdlib.wasp"
include "src/strings.wasp"
include "src/utils.wasp"
include "src/mem.wasp"

fn main() {
    a:int = 0;
    b:int = 1;

    println("Fibonacci sequence:");
    n:int = 100; // last numbers will overflow 64 bits

    i:int = 0;
    while i < n {
        println(fmt_dec(a));
        next:int = a + b;
        a = b;
        b = next;
        i++;
    }
}
