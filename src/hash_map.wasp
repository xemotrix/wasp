struct HashMapEntry {
    key: String;
    value: int;
    next: *HashMapEntry;
    filled: bool;
}

struct HashMap {
    arena:*ArenaHeader;
    entries:*HashMapEntry;
    n_entries:int;
}

// djb2
fn hash_string(s:String) int {
    hash:int = 5381;
    i:int = 0;
    while i < s.len {
        c:int = char_to_int(s.data[i]);
        hash = ((hash << 5) + hash) + c;
        i++;
    }
    if hash < 0 { hash = -hash; }
    return hash;
}

fn hm_new(n_entries:int) HashMap {
    hm:HashMap;
    hm.arena = arena_new(2 * n_entries*@size(HashMapEntry)); 
    hm.entries = aalloc(hm.arena, n_entries*@size(HashMapEntry));
    i:int = 0;
    while i < n_entries{
        hm.entries[i++].filled = false;
    }
    hm.n_entries = n_entries;
    return hm;
}

fn hm_destroy(hm:HashMap) {
    afree(hm.arena);
}

fn hm_get(hm:HashMap, key:String) *int {
    hash:int = hash_string(key);
    idx:int = hash % hm.n_entries;
    entry:*HashMapEntry = &hm.entries[idx];
    if !entry.filled { return 0; }
    while true {
        if entry.key == key { return &entry.value; }
        if entry.next == 0 { return 0; }
        entry = entry.next;
    }
    // unreachable
    return 0;
}

fn hm_set(hm:HashMap, key:String, value:int) {
    hash:int = hash_string(key);
    idx:int = hash % hm.n_entries;

    entry:*HashMapEntry = &hm.entries[idx];

    if !entry.filled {
        entry.key = key;
        entry.filled = true;
        entry.value = value;
        entry.next = 0;
        return;
    }

    while true {
        if entry.key == key {
            entry.value = value;
            return;
        }
        if entry.next == 0 {
            entry.next = aalloc(hm.arena, @size(HashMapEntry));
            entry.next.key = key;
            entry.next.filled = true;
            entry.next.value = value;
            entry.next.next = 0;
            return;
        }
        entry = entry.next;
    }
}
