include "src/stdlib.wasp"
include "src/utils.wasp"
include "src/token.wasp"
include "src/lexer.wasp"
include "src/ast.wasp"
include "src/parser.wasp"
include "src/render_ast.wasp"
include "src/hash_map.wasp"
include "src/sym.wasp"
include "src/sem.wasp"
include "src/codegen.wasp"
include "src/mem.wasp"
include "src/strings.wasp"

struct Flags {
    input_file:String;
    output_file:String;
}

fn error_usage() {
    println("Usage:");
    println("\t./wasp prog.wasp -o out.s");
    exit(1);
}

fn parse_flags(argc:int, argv:**char) Flags {
    if argc != 4 { 
        print("incorrect number of flags: ");
        println(fmt_dec(argc));
        error_usage(); 
    }
    f:Flags;

    f.input_file = to_string(argv[1]);
    out_file:*char;

    flag:String = to_string(argv[2]);

    if flag != "-o" { error_usage(); }

    f.output_file = to_string(argv[3]);

    return f;
}

fn main(argc:int, argv:**char) int {
    fl:Flags = parse_flags(argc, argv);

    lex(fl.input_file);
    println("======AFTER lex=======");
    check_heap_health();
    // debug_heap();
    ast:AST = parse();
    println("======AFTER parse=====");
    check_heap_health();
    // debug_heap();

    mfree(TOKENS.tokens);
    println("======AFTER free tokens=====");
    check_heap_health();
    // debug_heap();

    type_check(&ast);
    println("======AFTER typecheck=====");
    check_heap_health();
    // debug_heap();
    
    gen_asm(ast, fl.output_file);
    println("======AFTER codegen=====");
    check_heap_health();
    return 0;
}
