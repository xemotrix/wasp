include "src/stdlib.wasp"
include "src/utils.wasp"
include "src/token.wasp"
include "src/lexer.wasp"
include "src/ast.wasp"
include "src/parser.wasp"
include "src/render_ast.wasp"
include "src/sym.wasp"
include "src/sem.wasp"
include "src/codegen.wasp"
include "src/mem.wasp"

struct Flags {
    input_file:*char;
    output_file:*char;
}

fn error_usage() {
    println("Usage:");
    println("\t./wasp prog.wasp -o out.s");
    exit(1);
}

fn parse_flags(argc:int, argv:**char) Flags {
    if argc < 2 || argc == 3 || argc > 4 { 
        print("incorrect number of flags: ");
        println(fmt_dec(argc));
        error_usage(); 
    }
    f:Flags;

    f.input_file = argv[1];
    out_file:*char;
    if argc == 2 {
        len_in:int = strlen(f.input_file);
        f.output_file = alloc(len_in);
        i:int = 0;
        while (i < len_in) {
            f.output_file[i] = f.input_file[i];
            if f.input_file[i] == '.' { break; }
        }
        f.output_file[i] = 's';
        f.output_file[i+1] = '\0';
    }
    if argc == 4 {
        flag:*char = argv[2];
        if !streq(flag, "-o", 2) { error_usage(); }
        f.output_file = argv[3];
    }
    return f;
}

fn main(argc:int, argv:**char) int {
    fl:Flags = parse_flags(argc, argv);

    lex(fl.input_file);
    println("======AFTER lex=======");
    // debug_heap();
    ast:AST = parse();
    // debug_heap();

    println("finished parsing");
    mfree(TOKENS.tokens);
    // println("======AFTER parse=====");
    // debug_heap();

    type_check(&ast);
    // println("======AFTER typecheck=====");
    // debug_heap();
    // render_ast(&ast);
    println("finished semantic analysis");

    gen_asm(ast, fl.output_file);
    println("finished codegen");
    return 0;
}
