struct String {
    data:*char;
    len:int;
}

fn to_string(data:*char) String {
    s:String;
    s.data = data;
    s.len = strlen(data);
    return s;
}

fn to_cstring(str:String) *char {
    s:*char = malloc(str.len+1);
    i:int = 0;
    while i < str.len {
        s[i] = str.data[i];
        i++;
    }
    s[i] = '\0';
    return s;
}

fn string_new(data:*char, len:int) String {
    s:String;
    s.data = data;
    s.len = len;
    return s;
}

fn string_eq_cstring(s:String, cs:*char) bool {
    i:int = 0;
    while i < s.len {
        if s.data[i] != cs[i] { return false; }
        i++;
    }
    return true;
}


struct StringBuilder {
    start:*char;
    len:int;
    cap:int;
}
