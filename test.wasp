include "src/stdlib.wasp"
include "src/mem.wasp"


struct Xd {
    a:int;
    b:int;
    c:int;
}

fn main() int {
    arr0:*Xd = malloc(@size(Xd));
    arr1:*Xd = malloc(@size(Xd));
    arr2:*Xd = malloc(@size(Xd));
    arr3:*Xd = malloc(@size(Xd));
    arr4:*Xd = malloc(@size(Xd));

    print(">>>>>>MALLOCS");
    debug_heap();

    mfree(arr1);
    print(">>>>>>FREE1");
    debug_heap();

    mfree(arr3);
    print(">>>>>>FREE2");
    debug_heap();

    mfree(arr2);
    print(">>>>>>FREE3");
    debug_heap();
    return 0;
}

