////////////////////////////////////
// STDLIB                         //
////////////////////////////////////
const SYS_READ:int   = 0;
const SYS_WRITE:int  = 1;
const SYS_OPEN:int   = 2;
const SYS_MMAP:int   = 9;
const SYS_MUNMAP:int = 11;
const SYS_EXIT:int   = 60;

const PROT_READ:int     = 1;
const PROT_WRITE:int    = 3;
const MAP_PRIVATE:int   = 2;
const MAP_ANONYMOUS:int = 32;

const STDOUT:int = 1;

fn strlen(str:*char) int {
    i:int = 0;
    while str[i] != '\0' {
        i = i+1;
    }
    return i;
}

fn write(str:*char, len:int) int {
    return syscall(SYS_WRITE, STDOUT, str, len);
}

fn print(str:*char) {
    len:int = strlen(str);
    write(str, len);
}

fn println(str:*char) {
    print(str);
    print("\n");
}

fn exit(code:int) {
    syscall(SYS_EXIT, code);
}

fn strncmp(a:*char, b:*char, len:int) bool {
    i:int = 0;
    while i < len {
        if a[i] != b[i] {
            return false;
        }
        i=i+1;
    }
    return true;
}

fn munmap(addr:int, size:int) int {
    return syscall(SYS_MUNMAP, addr, size);
}

fn mmap(size:int) int {
    fd:int = -1;
    offset:int = 0;
    addr:int=0;
    return syscall(SYS_MMAP,addr,size,PROT_READ|PROT_WRITE,MAP_PRIVATE|MAP_ANONYMOUS,fd,offset);
}

fn alloc(size:int) int {
    ptr:*int = mmap(size+8);
    *ptr = size;
    return ptr+8;
}

fn realloc(old_ptr:*int, new_size:int) int {
    old_size:int = old_ptr[-1];
    if new_size < old_size {
        return old_ptr; // memory is cheap lmao
    }
    new_ptr:*int = alloc(new_size);
    offset:int = 0;
    while (offset < old_size) {
        new_ptr[offset] = old_ptr[offset];
        offset=offset+8;
    }
    return new_ptr;
}

fn free(ptr:*int) int {
    size:int = ptr[-8];
    return munmap(ptr-8, size+8);
}

fn open(filename:*char) int {
    return syscall(SYS_OPEN, filename, 0, 0);
}

fn read(fd:int, buf:*char, count:int) int {
    return syscall(SYS_READ, fd, buf, count);
}

fn read_file(filename:*char) *char {
    fd:int = open(filename);
    if fd < 0 {
        println("Error reading file");
        exit(1);
    }
    buf:*char = alloc(4096*100);
    to_read:int = 1024;
    chunk_c:int = 0;
    while true {
        bread:int = read(fd, buf+chunk_c*to_read, to_read);
        if bread == 0 {
            println("No bytes read :(");
            exit(1);
        }
        if bread == to_read {
            println("there is more to read...");
        }
        if bread != to_read {
            println("there is NO more to read!");
            break;
        }
        chunk_c = chunk_c + 1;
    }
    return buf;
}

fn fmt_hex(num:int) *char {
    out:*char = alloc(16+3);
    hex:*char = "0123456789abcdef";
    *out = '0';
    *(out+1) = 'x';
    i:int=0;
    shift:int;
    idx:int;
    while i < 16 {
        shift = (15-i) * 4;
        idx = (num>>shift)&15;
        out[i+2] = hex[idx];
        i=i+1;
    }
    out[16+3] = '\0';
    return out;
}

fn strcat(a:*char, b:*char) *char {
    lena:int = strlen(a);
    lenb:int = strlen(b);
    new:*char = alloc(lena+lenb);
    ptr:*char = new;
    i:int = 0;
    while i < lena {
        *ptr = a[i];
        ptr=ptr+1;
        i=i+1;
    }
    i = 0;
    while i < lenb {
        *ptr = b[i];
        ptr=ptr+1;
        i=i+1;
    }
    return new;
}

fn streq(a:*char, b:*char, len:int) bool {
    i:int = 0;
    while i < len {
        if a[i] == '\0' || b[i] == '\0' {
            return false;
        }
        if a[i] != b[i] {
            return false;
        }
        i=i+1;
    }
    return true;
} 


//////////////////////////////////////////////////

fn check_num(expected_str:*char, expected: int, num:int) int {
    if num == expected {
        print("OK: expected: (");
        print(expected_str);
        print("), got: ");
        println(fmt_hex(num));
    }
    if num != expected {
        print("FAIL: expected ");
        print(fmt_hex(expected));
        print(" but got ");
        println(fmt_hex(num));
    }
    return 0;
}

fn test0() int {
    println("=====test0=====");
    num:int = 42;
    arr:*int = alloc(8*num);
    i:int = 0;
    while (i < num) {
        arr[i] = 1<<i;
        i=i+1;
    }
    accum:int = 0;
    i = 0;
    while (i < num) {
        accum = accum + arr[i];
        i=i+1;
    }
    check_num("0x000003ffffffffff", 4398046511103, accum);
    return 0;
}

struct XD {
    aa: int;
    bb: int;
}

fn test1() {
    println("=====test1=====");
    num:int = 10;
    arr:*XD = alloc(16*num);

    t:XD;
    t.aa=15;
    t.bb=14;
    arr[3] = t;
    check_num("0xf", 15, arr[3].aa);
    check_num("0xe", 14, arr[3].bb);
}

fn test2() {
    println("=====test2=====");
    num:int = 10;
    arr:*XD = alloc(16*num);

    arr[4].aa = 15;
    check_num("0xf", 15, arr[4].aa);
}

fn test3() {
    println("=====test3=====");
    num:int = 10;
    arr:*char = alloc(num);
    source:*char = "if you see a # it's ok >?< here!";
    len:int = strlen(source);
    i:int=0;
    while i < len {
        arr[i] = source[i];
        i=i+1;
    }
    arr[24] = '#';
    println(arr);
}


struct NestedB {
    value_c:char;
    value_i:int;
}
struct NestedA {
    int_arr:*int;
    str_arr:*NestedB;
}

fn test4() {
    println("=====test4=====");
    aptr:*NestedA = alloc(16);
    num:int = 30;
    aptr.int_arr = alloc(8*num);
    aptr.str_arr = alloc(16*num);

    aptr.int_arr[13] = 42;
    check_num("2a", 42, aptr.int_arr[13]);

    aptr.str_arr[14].value_i = 42;
    check_num("2a", 42, aptr.str_arr[14].value_i);
}

fn test5() {
    println("=====test5=====");
    arr:*int = alloc(8*10);
    i:int = 0;
    while i < 10 {
        arr[i] = i;
        i=i+1;
    }
    ref:*int = &arr[7];
    res:int = *ref;
    check_num("0x7", 7, res);
}

struct SubTest {
    x:int;
    y:int;
}
struct Test {
    a:int;
    s:SubTest;
    b:int;
} // size: 32
fn test6() {
    println("=====test6=====");
    t:Test;
    t.a = 1;
    t.s.x = 2;
    t.s.y = 3;
    t.b = 4;

    h:*Test = alloc(5000);
    h[1] = t;

    check_num("0x1", 1, t.a);
    check_num("0x2", 2, t.s.x);
    check_num("0x3", 3, t.s.y);
    check_num("0x4", 4, t.b);

    tp:*Test = &h[1];
    check_num("0x1", 1, tp.a);
    check_num("0x2", 2, tp.s.x);
    check_num("0x3", 3, tp.s.y);
    check_num("0x4", 4, tp.b);
}

struct Holder{
    xd:int;
    tt:*Test;
    what:int;
}
fn test7() {
    println("=====test7=====");
    h:Holder;
    h.tt = alloc(5000);
    h.tt[1].a = 1;
    h.tt[1].s.x = 2;
    h.tt[1].s.y = 3;
    h.tt[1].b = 4;

    check_num("0x1", 1, h.tt[1].a);
    check_num("0x2", 2, h.tt[1].s.x);
    check_num("0x3", 3, h.tt[1].s.y);
    check_num("0x4", 4, h.tt[1].b);

    tp:*Test = &h.tt[1];
    check_num("0x1", 1, tp.a);
    check_num("0x2", 2, tp.s.x);
    check_num("0x3", 3, tp.s.y);
    check_num("0x4", 4, tp.b);
}

fn foo8(n:int) Test {
    t:Test;
    t.a = n;
    t.s.x = n+1;
    t.s.y = n+2;
    t.b = n+3;
    return t;
}
fn test8() {
    println("=====test8=====");
    h:Holder;
    h.tt = alloc(5000);
    h.tt[1] = foo8(1);
    h.tt[2] = foo8(5);

    check_num("0x1", 1, h.tt[1].a);
    check_num("0x2", 2, h.tt[1].s.x);
    check_num("0x3", 3, h.tt[1].s.y);
    check_num("0x4", 4, h.tt[1].b);
    check_num("0x5", 5, h.tt[2].a);
    check_num("0x6", 6, h.tt[2].s.x);
    check_num("0x7", 7, h.tt[2].s.y);
    check_num("0x8", 8, h.tt[2].b);

    tp:*Test = &h.tt[1];
    check_num("0x1", 1, tp.a);
    check_num("0x2", 2, tp.s.x);
    check_num("0x3", 3, tp.s.y);
    check_num("0x4", 4, tp.b);
    tp = &h.tt[2];
    check_num("0x5", 5, tp.a);
    check_num("0x6", 6, tp.s.x);
    check_num("0x7", 7, tp.s.y);
    check_num("0x8", 8, tp.b);
}

fn main () int {
   test0();
   test1();
   test2();
   test3();
   test4();
   test5();
   test6();
   test7();
   test8();

   return 0;
}
