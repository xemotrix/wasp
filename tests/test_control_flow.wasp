////////////////////////////////////
// STDLIB                         //
////////////////////////////////////
const SYS_READ:int   = 0;
const SYS_WRITE:int  = 1;
const SYS_OPEN:int   = 2;
const SYS_MMAP:int   = 9;
const SYS_MUNMAP:int = 11;
const SYS_EXIT:int   = 60;

const PROT_READ:int     = 1;
const PROT_WRITE:int    = 3;
const MAP_PRIVATE:int   = 2;
const MAP_ANONYMOUS:int = 32;

const STDOUT:int = 1;

fn strlen(str:*char) int {
    i:int = 0;
    while str[i] != '\0' {
        i = i+1;
    }
    return i;
}

fn write(str:*char, len:int) int {
    return @syscall(SYS_WRITE, STDOUT, str, len);
}

fn print(str:*char) {
    len:int = strlen(str);
    write(str, len);
}

fn println(str:*char) {
    print(str);
    print("\n");
}

fn exit(code:int) {
    @syscall(SYS_EXIT, code);
}

fn strncmp(a:*char, b:*char, len:int) bool {
    i:int = 0;
    while i < len {
        if a[i] != b[i] {
            return false;
        }
        i=i+1;
    }
    return true;
}

fn munmap(addr:int, size:int) int {
    return @syscall(SYS_MUNMAP, addr, size);
}

fn mmap(size:int) int {
    fd:int = -1;
    offset:int = 0;
    addr:int=0;
    return @syscall(SYS_MMAP,addr,size,PROT_READ|PROT_WRITE,MAP_PRIVATE|MAP_ANONYMOUS,fd,offset);
}

fn alloc(size:int) int {
    ptr:*int = mmap(size+8);
    *ptr = size;
    return ptr+8;
}

fn realloc(old_ptr:*int, new_size:int) int {
    old_size:int = old_ptr[-1];
    if new_size < old_size {
        return old_ptr; // memory is cheap lmao
    }
    new_ptr:*int = alloc(new_size);
    offset:int = 0;
    while (offset < old_size) {
        new_ptr[offset] = old_ptr[offset];
        offset=offset+8;
    }
    return new_ptr;
}

fn free(ptr:*int) int {
    size:int = ptr[-8];
    return munmap(ptr-8, size+8);
}

fn open(filename:*char) int {
    return @syscall(SYS_OPEN, filename, 0, 0);
}

fn read(fd:int, buf:*char, count:int) int {
    return @syscall(SYS_READ, fd, buf, count);
}

fn read_file(filename:*char) *char {
    fd:int = open(filename);
    if fd < 0 {
        println("Error reading file");
        exit(1);
    }
    buf:*char = alloc(4096*100);
    to_read:int = 1024;
    chunk_c:int = 0;
    while true {
        bread:int = read(fd, buf+chunk_c*to_read, to_read);
        if bread == 0 {
            println("No bytes read :(");
            exit(1);
        }
        if bread == to_read {
            println("there is more to read...");
        }
        if bread != to_read {
            println("there is NO more to read!");
            break;
        }
        chunk_c = chunk_c + 1;
    }
    return buf;
}

fn fmt_hex(num:int) *char {
    out:*char = alloc(16+3);
    hex:*char = "0123456789abcdef";
    *out = '0';
    *(out+1) = 'x';
    i:int=0;
    shift:int;
    idx:int;
    while i < 16 {
        shift = (15-i) * 4;
        idx = (num>>shift)&15;
        out[i+2] = hex[idx];
        i=i+1;
    }
    out[16+3] = '\0';
    return out;
}

fn strcat(a:*char, b:*char) *char {
    lena:int = strlen(a);
    lenb:int = strlen(b);
    new:*char = alloc(lena+lenb);
    ptr:*char = new;
    i:int = 0;
    while i < lena {
        *ptr = a[i];
        ptr=ptr+1;
        i=i+1;
    }
    i = 0;
    while i < lenb {
        *ptr = b[i];
        ptr=ptr+1;
        i=i+1;
    }
    return new;
}

fn streq(a:*char, b:*char, len:int) bool {
    i:int = 0;
    while i < len {
        if a[i] == '\0' || b[i] == '\0' {
            return false;
        }
        if a[i] != b[i] {
            return false;
        }
        i=i+1;
    }
    return true;
} 


////////////////////////////////////
// TEST                           //
////////////////////////////////////

fn check_num(expected_str:*char, expected: int, num:int) int {
    if (num == expected){
        print("OK: expected: (");
        print(expected_str);
        print("), got: ");
        println(fmt_hex(num));
    }
    if (num != expected) {
        print("FAIL: expected ");
        print(fmt_hex(expected));
        print(" but got ");
        println(fmt_hex(num));
    }
    return 0;
}

fn test0() {
    println("====test0====");
    i:int = 0;
    sum:int = 0;
    while i < 100 {
        sum = sum + i;
        i=i+1;
    }
    check_num("0x1356", 4950, sum);
}

fn test1() {
    println("====test1====");
    i:int = 0;
    while i < 100 {
        if i == 42 {
            break;
        }
        i=i+1;
    }
    check_num("0x2a", 42, i);
}

fn test2() {
    println("====test2====");
    i:int = 0;
    while i < 100 {
        i=i+1;
        if i < 42 {
            continue;
        }
        if i < 42 {
            println("failed!");
            exit(1);
        }
    }
    check_num("0x64", 100, i);
}

fn test3() {
    println("====test3====");
    // check that the "j:int" inside the while is propperly allocated
    // with all locals
    i:int = 0;
    while i < 100 {
        i=i+1;
        j:int = 42;
    }
    check_num("0x64", 100, i);
    check_num("0x2a", 42, *(&i - 8));
}

fn main() int {
    test0();
    test1();
    test2();
    test3();

    return 0;
}
