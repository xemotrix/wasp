fn bar9(s:What) int {
    check_num("0x0e", 14, s.one);
    check_num("0x45", 69, s.two);
    s.one = 42;
    check_num("0x2a", 42, s.one);
    check_num("0x45", 69, s.two);
    return 0;
}
fn foo9(s:What) int {
    check_num("0x0e", 14, s.one);
    check_num("0x0f", 15, s.two);
    s.two = 69;
    bar9(s);
    check_num("0x0e", 14, s.one);
    check_num("0x45", 69, s.two);
    return 0;
}
fn test9() {
    println("=====test9=====");
