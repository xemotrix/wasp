////////////////////////////////////
// STDLIB                         //
////////////////////////////////////
const SYS_READ:int   = 0;
const SYS_WRITE:int  = 1;
const SYS_OPEN:int   = 2;
const SYS_MMAP:int   = 9;
const SYS_MUNMAP:int = 11;
const SYS_EXIT:int   = 60;

const PROT_READ:int     = 1;
const PROT_WRITE:int    = 3;
const MAP_PRIVATE:int   = 2;
const MAP_ANONYMOUS:int = 32;

const STDOUT:int = 1;

fn strlen(str:*char) int {
    i:int = 0;
    while str[i] != '\0' {
        i = i+1;
    }
    return i;
}

fn write(str:*char, len:int) int {
    return syscall(SYS_WRITE, STDOUT, str, len);
}

fn print(str:*char) {
    len:int = strlen(str);
    write(str, len);
}

fn println(str:*char) {
    print(str);
    print("\n");
}

fn exit(code:int) {
    syscall(SYS_EXIT, code);
}

fn strncmp(a:*char, b:*char, len:int) bool {
    i:int = 0;
    while i < len {
        if a[i] != b[i] {
            return false;
        }
        i=i+1;
    }
    return true;
}

fn munmap(addr:int, size:int) int {
    return syscall(SYS_MUNMAP, addr, size);
}

fn mmap(size:int) int {
    fd:int = -1;
    offset:int = 0;
    addr:int=0;
    return syscall(SYS_MMAP,addr,size,PROT_READ|PROT_WRITE,MAP_PRIVATE|MAP_ANONYMOUS,fd,offset);
}

fn alloc(size:int) int {
    ptr:*int = mmap(size+8);
    *ptr = size;
    return ptr+8;
}

fn realloc(old_ptr:*int, new_size:int) int {
    old_size:int = old_ptr[-1];
    if new_size < old_size {
        return old_ptr; // memory is cheap lmao
    }
    new_ptr:*int = alloc(new_size);
    offset:int = 0;
    while (offset < old_size) {
        new_ptr[offset] = old_ptr[offset];
        offset=offset+8;
    }
    return new_ptr;
}

fn free(ptr:*int) int {
    size:int = ptr[-8];
    return munmap(ptr-8, size+8);
}

fn open(filename:*char) int {
    return syscall(SYS_OPEN, filename, 0, 0);
}

fn read(fd:int, buf:*char, count:int) int {
    return syscall(SYS_READ, fd, buf, count);
}

fn read_file(filename:*char) *char {
    fd:int = open(filename);
    if fd < 0 {
        println("Error reading file");
        exit(1);
    }
    buf:*char = alloc(4096*100);
    to_read:int = 1024;
    chunk_c:int = 0;
    while true {
        bread:int = read(fd, buf+chunk_c*to_read, to_read);
        if bread == 0 {
            println("No bytes read :(");
            exit(1);
        }
        if bread == to_read {
            println("there is more to read...");
        }
        if bread != to_read {
            println("there is NO more to read!");
            break;
        }
        chunk_c = chunk_c + 1;
    }
    return buf;
}

fn fmt_hex(num:int) *char {
    out:*char = alloc(16+3);
    hex:*char = "0123456789abcdef";
    *out = '0';
    *(out+1) = 'x';
    i:int=0;
    shift:int;
    idx:int;
    while i < 16 {
        shift = (15-i) * 4;
        idx = (num>>shift)&15;
        out[i+2] = hex[idx];
        i=i+1;
    }
    out[16+3] = '\0';
    return out;
}

fn strcat(a:*char, b:*char) *char {
    lena:int = strlen(a);
    lenb:int = strlen(b);
    new:*char = alloc(lena+lenb);
    ptr:*char = new;
    i:int = 0;
    while i < lena {
        *ptr = a[i];
        ptr=ptr+1;
        i=i+1;
    }
    i = 0;
    while i < lenb {
        *ptr = b[i];
        ptr=ptr+1;
        i=i+1;
    }
    return new;
}

fn streq(a:*char, b:*char, len:int) bool {
    i:int = 0;
    while i < len {
        if a[i] == '\0' || b[i] == '\0' {
            return false;
        }
        if a[i] != b[i] {
            return false;
        }
        i=i+1;
    }
    return true;
} 

////////////////////////////////////
// TEST                           //
////////////////////////////////////

struct What {
    one: int;
    two: int;
}

struct Lmao {
    aaaa: int;
    bbbb: int;
    pppp: *What;
}

struct Test {
    name: int;
    xd: Lmao;
}

fn check_num(expected_str:*char, expected: int, num:int) {
    if num == expected {
        print("OK: expected: (");
        print(expected_str);
        print("), got: ");
        println(fmt_hex(num));
    }
    if num != expected {
        print("FAIL: expected ");
        print(fmt_hex(expected));
        print(" but got ");
        println(fmt_hex(num));
    }
    return;
}

fn test0() {
    println("=====test0=====");
    i:Test;
    i.name =  54491065313;
    i.xd.aaaa = 54491065314;
    i.xd.bbbb = 54491065315;

    check_num("0xcafebabe1", 54491065313, i.name);
    check_num("0xcafebabe2", 54491065314, i.xd.aaaa);
    check_num("0xcafebabe3", 54491065315, i.xd.bbbb);

    new_lmao:Lmao;
    new_lmao.aaaa=15;
    new_lmao.bbbb=15<<8;
    check_num("0x00f", 15, new_lmao.aaaa);
    check_num("0xf00",15<<8, new_lmao.bbbb);

    i.xd = new_lmao;

    check_num("0x00f", 15, i.xd.aaaa);
    check_num("0xf00", 15<<8, i.xd.bbbb);

    w:*What = alloc(16);
    w.one = (1<<8)+1;
    w.two = (2<<8)+2;

    i.xd.pppp=w;

    check_num("0x101",w.one, i.xd.pppp.one);
    check_num("0x202",w.two, i.xd.pppp.two);
    
    i.xd.pppp.one = 3;
    i.xd.pppp.two = 5;

    check_num("0x3", 3, i.xd.pppp.one);
    check_num("0x5", 5, i.xd.pppp.two);

    oof:Lmao = i.xd;

    check_num("0x3", 3, oof.pppp.one);
    check_num("0x5", 5, oof.pppp.two);

    check_num("0x3", 3, i.xd.pppp.one);
    check_num("0x5", 5, i.xd.pppp.two);
}

fn test1() {
    println("=====test1=====");
    a:Test;
    b:Lmao;

    b.bbbb = 15;
    a.xd = b;
    check_num("0x0000f", 15, a.xd.bbbb);

    w:*What = alloc(16);
    w.one = 15<<8;
    w.two = 15<<16;
    
    a.xd.pppp = w;

    check_num("0x00f00", 15<<8, a.xd.pppp.one);
    check_num("0xf0000", 15<<16, a.xd.pppp.two);
}

fn test2() {
    println("=====test2=====");
    a:Test;
    b:Lmao;

    a2:Test;
    b2:Lmao;

    a2.xd.aaaa = 15;
    a2.xd.bbbb = 14;
    check_num("0xf", 15, a2.xd.aaaa);
    check_num("0xe", 14, a2.xd.bbbb);

    a.xd = a2.xd;
    check_num("0xf", 15, a.xd.aaaa);
    check_num("0xe", 14, a.xd.bbbb);

    check_num("0xf", a2.xd.aaaa, a.xd.aaaa);
    check_num("0xe", a2.xd.bbbb, a.xd.bbbb);
}

fn test3() {
    println("=====test3=====");
    a:Test;
    a.xd.bbbb = 15;
    a.xd.aaaa = 14;

    ptr1:*int = &a.xd.bbbb;
    res:int = *ptr1;
    check_num("0xf", 15, a.xd.bbbb);
    check_num("0xf", 15, res);

    ptr2:*Lmao = &a.xd;
    b:Lmao;
    
    b = *ptr2;
    check_num("0xf", 15, b.bbbb);
}

fn foo4(a:int, w:What, b:int) int {
    w2:What = w;
    w2.two = 3;
    return a + w2.two + w.two + b;
}
fn test4() {
    println("=====test4=====");
    t:Test;
    t.name = 1;
    t.xd.aaaa = 2;
    t.xd.bbbb = 3;
    t.xd.pppp = alloc(16);
    t.xd.pppp.one = 14;
    t.xd.pppp.two = 15;
    res:int = foo4(1, *(t.xd.pppp), 2);
    check_num("0x15", 21, res);
}

