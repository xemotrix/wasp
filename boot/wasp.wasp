////////////////////////////////////
// STDLIB                         //
////////////////////////////////////
const SYS_READ:int   = 0;
const SYS_WRITE:int  = 1;
const SYS_OPEN:int   = 2;
const SYS_CLOSE:int  = 3;
const SYS_MMAP:int   = 9;
const SYS_MUNMAP:int = 11;
const SYS_EXIT:int   = 60;

const PROT_READ:int     = 1;
const PROT_WRITE:int    = 3;
const MAP_PRIVATE:int   = 2;
const MAP_ANONYMOUS:int = 32;

const O_WRONLY:int = 1;
const O_CREAT:int = 64;
const O_TRUNC:int = 512;
const O_APPEND:int = 1024;
const O_PERM:int = 420;

const STDOUT:int = 1;

fn strlen(str:*char) int {
    i:int = 0;
    while str[i] != '\0' {
        i = i+1;
    }
    return i;
}

fn write_to(fd:int, str:*char, len:int) int {
    return syscall(SYS_WRITE, fd, str, len);
}

fn write(str:*char, len:int) int {
    return syscall(SYS_WRITE, STDOUT, str, len);
}

fn print(str:*char) {
    len:int = strlen(str);
    write(str, len);
}

fn println(str:*char) {
    print(str);
    print("\n");
}

fn exit(code:int) {
    syscall(SYS_EXIT, code);
}

fn strncmp(a:*char, b:*char, len:int) bool {
    i:int = 0;
    while i < len {
        if a[i] != b[i] {
            return false;
        }
        i=i+1;
    }
    return true;
}

fn munmap(addr:int, size:int) int {
    return syscall(SYS_MUNMAP, addr, size);
}

fn mmap(size:int) int {
    fd:int = -1;
    offset:int = 0;
    addr:int=0;
    return syscall(SYS_MMAP,addr,size,PROT_READ|PROT_WRITE,MAP_PRIVATE|MAP_ANONYMOUS,fd,offset);
}

fn alloc(size:int) int {
    ptr:*int = mmap(size+8);
    *ptr = size;
    return ptr+8;
}

fn realloc(old_ptr:*int, new_size:int) int {
    old_size:int = old_ptr[-1];
    if new_size < old_size {
        return old_ptr; // memory is cheap lmao
    }
    new_ptr:*int = alloc(new_size);
    offset:int = 0;
    i:int = 0;
    while (offset < old_size) {
        new_ptr[i] = old_ptr[i];
        offset=offset+8;
        i=i+1;
    }
    return new_ptr;
}

fn free(ptr:*int) int {
    size:int = ptr[-8];
    return munmap(ptr-8, size+8);
}

fn open(filename:*char, flags:int, mode:int) int {
    return syscall(SYS_OPEN, filename, flags, mode);
}

fn close(fd:int) int {
    return syscall(SYS_CLOSE, fd);
}

fn read(fd:int, buf:*char, count:int) int {
    return syscall(SYS_READ, fd, buf, count);
}

fn read_file(filename:*char) *char {
    fd:int = open(filename, 0, 0);
    if fd < 0 {
        println("Error reading file");
        exit(1);
    }
    buf:*char = alloc(4096*100);
    to_read:int = 4096;
    chunk_c:int = 0;
    while true {
        bread:int = read(fd, buf+chunk_c*to_read, to_read);
        if bread == 0 && chunk_c == 0 {
            println("No bytes read :(");
            exit(1);
        }
        if bread == to_read {
            println("there is more to read...");
        }
        if bread != to_read {
            println("there is NO more to read!");
            break;
        }
        chunk_c = chunk_c + 1;
    }
    return buf;
}

fn fmt_dec(num:int) *char {
    out:*char = alloc(20);
    idx:int = 0;
    if num < 0 {
        out[idx] = '-';
        num = -num;
        idx=idx+1;
    }
    if num == 0 {
        out[0] = '0';
        return out;
    }
    start:int = idx;
    while num != 0 {
        mod:int = num % 10;
        if mod == 0 { out[idx] = '0'; }
        if mod == 1 { out[idx] = '1'; }
        if mod == 2 { out[idx] = '2'; }
        if mod == 3 { out[idx] = '3'; }
        if mod == 4 { out[idx] = '4'; }
        if mod == 5 { out[idx] = '5'; }
        if mod == 6 { out[idx] = '6'; }
        if mod == 7 { out[idx] = '7'; }
        if mod == 8 { out[idx] = '8'; }
        if mod == 9 { out[idx] = '9'; }
        idx = idx+1;
        num = num / 10;
    }
    end:int = idx-1;
    while start < end {
        aux:char = out[start];
        out[start] = out[end];
        out[end] = aux;
        start=start+1;
        end=end-1;
    }
    return out;
}

fn fmt_hex(num:int) *char {
    out:*char = alloc(16+3);
    hex:*char = "0123456789abcdef";
    out[0] = '0';
    out[1] = 'x';
    i:int=0;
    shift:int;
    idx:int;
    while i < 16 {
        shift = (15-i) * 4;
        idx = (num>>shift)&15;
        out[i+2] = hex[idx];
        i=i+1;
    }
    out[16+3] = '\0';
    return out;
}

fn strcat(a:*char, b:*char) *char {
    lena:int = strlen(a);
    lenb:int = strlen(b);
    new:*char = alloc(lena+lenb);
    ptr:*char = new;
    i:int = 0;
    while i < lena {
        *ptr = a[i];
        ptr=ptr+1;
        i=i+1;
    }
    i = 0;
    while i < lenb {
        *ptr = b[i];
        ptr=ptr+1;
        i=i+1;
    }
    return new;
}

fn streq(a:*char, b:*char, len:int) bool {
    i:int = 0;
    while i < len {
        if a[i] == '\0' || b[i] == '\0' {
            return false;
        }
        if a[i] != b[i] {
            return false;
        }
        i=i+1;
    }
    return true;
} 

////////////////////////////////////
// UTILS                          //
////////////////////////////////////

fn error(msg:*char) {
    print("ERROR: ");
    println(msg);
    exit(1);
}

fn assert(expr:bool) {
    if !expr {
        println("ASSERT FAILED");
        exit(1);
    }
}

////////////////////////////////////
// TOKENS                         //
////////////////////////////////////

const TOK_IDEN:int         = 0;
const TOK_LIT_INT:int      = 1;
const TOK_LIT_BOOL:int     = 2;
const TOK_LIT_STRING:int   = 3;
const TOK_LIT_CHAR:int     = 4;
const TOK_TY_VOID:int      = 5;
const TOK_TY_INT:int       = 6;
const TOK_TY_BOOL:int      = 7;
const TOK_TY_CHAR:int      = 8;
const TOK_KW_IF:int        = 9;
const TOK_KW_WHILE:int     = 10;
const TOK_KW_BREAK:int     = 11;
const TOK_KW_RETURN:int    = 12;
const TOK_KW_CONST:int     = 13;
const TOK_KW_VAR:int       = 14;
const TOK_KW_STRUCT:int    = 15;
const TOK_KW_CONTINUE:int  = 16;
const TOK_KW_FN:int        = 17;
const TOK_BANG:int         = 18;
const TOK_TILDE:int        = 19;
const TOK_EQUALSEQUALS:int = 20;
const TOK_BANGEQUALS:int   = 21;
const TOK_GT:int           = 22;
const TOK_GTE:int          = 23;
const TOK_LT:int           = 24;
const TOK_LTE:int          = 25;
const TOK_AND:int          = 26;
const TOK_OR:int           = 27;
const TOK_BIT_OR:int       = 28;
const TOK_AMPERSAND:int    = 29;
const TOK_PLUS:int         = 30;
const TOK_MINUS:int        = 31;
const TOK_SHIFT_LEFT:int   = 32;
const TOK_SHIFT_RIGHT:int  = 33;
const TOK_ASTERISK:int     = 34;
const TOK_PERCENT:int      = 35;
const TOK_SLASH:int        = 36;
const TOK_PERIOD:int       = 37;
const TOK_EQUALS:int       = 38;
const TOK_SEMICOLON:int    = 39;
const TOK_COLON:int        = 40;
const TOK_COMMA:int        = 41;
const TOK_LPAREN:int       = 42;
const TOK_RPAREN:int       = 43;
const TOK_LCURLY:int       = 44;
const TOK_RCURLY:int       = 45;
const TOK_LSQBR:int        = 46;
const TOK_RSQBR:int        = 47;
const TOK_EOF:int          = 48;

struct Token {
  type:int;
  text:*char;
  text_len:int;
}

////////////////////////////////////
// LEXER                          //
////////////////////////////////////

fn is_whitespace(c:char) bool { return c == ' ' || c == '\t' || c == '\r' || c == '\n'; }
fn is_alpha(c:char ) bool { return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z'); }
fn is_digit(c:char) bool { return c >= '0' && c <= '9'; }

fn peek_token(src:*char) Token {
    ref:*char = 0;
    while (ref != src) {
        ref = src;
        while is_whitespace(*src) { src = src+1; }
        src = src + len_skip_comments(src);
    }

    t:Token;
    if (*src == '\0'){
        t.type = TOK_EOF;
        return t;
    }

    if is_digit(*src) { return lex_num(src); }
    if is_alpha(*src) { return lex_iden(src); }
    if *src == '"' { return lex_string(src); }
    if *src == '\'' { return lex_char(src); }

    t.text = src;
    t.text_len = 1;

    t.type = -1;

    if *src == '(' { t.type = TOK_LPAREN; }
    if *src == ')' { t.type = TOK_RPAREN; }
    if *src == '{' { t.type = TOK_LCURLY; }
    if *src == '}' { t.type = TOK_RCURLY; }
    if *src == '[' { t.type = TOK_LSQBR; }
    if *src == ']' { t.type = TOK_RSQBR; }
    if *src == '+' { t.type = TOK_PLUS; }
    if *src == '-' { t.type = TOK_MINUS; }
    if *src == '*' { t.type = TOK_ASTERISK; }
    if *src == '%' { t.type = TOK_PERCENT; }
    if *src == '/' { t.type = TOK_SLASH; }
    if *src == ';' { t.type = TOK_SEMICOLON; }
    if *src == ':' { t.type = TOK_COLON; }
    if *src == ',' { t.type = TOK_COMMA; }
    if *src == '.' { t.type = TOK_PERIOD; }
    if *src == '~' { t.type = TOK_TILDE; }
    if *src == '!' {
        t.type = TOK_BANG;
        if src[1] != '\0' && src[1] == '=' {
            t.type = TOK_BANGEQUALS;
            t.text_len = t.text_len+1;
        }
    }
    if *src == '|' {
        t.type = TOK_BIT_OR;
        if src[1] != '\0' && src[1] == '|' {
            t.text_len = t.text_len+1;
            t.type = TOK_OR;
        }
    }
    if *src == '&' {
        t.type = TOK_AMPERSAND;
        if src[1] != '\0' && src[1] == '&' {
            t.text_len = t.text_len+1;
            t.type = TOK_AND;
        }
    }
    if *src == '<' {
        t.type = TOK_LT;
        if src[1] != '\0' && src[1] == '=' {
            t.text_len = t.text_len+1;
            t.type = TOK_LTE;
        }
        if src[1] != '\0' && src[1] == '<' {
            t.text_len = t.text_len+1;
            t.type = TOK_SHIFT_LEFT;
        }
    }
    if *src == '>' {
        t.type = TOK_GT;
        if src[1] != '\0' && src[1] == '=' {
            t.text_len = t.text_len+1;
            t.type = TOK_GTE;
        }
        if src[1] != '\0' && src[1] == '>' {
            t.text_len = t.text_len+1;
            t.type = TOK_SHIFT_RIGHT;
        }
    }
    if *src == '=' {
        t.type = TOK_EQUALS;
        if src[1] != '\0' && src[1] == '=' {
            t.text_len = t.text_len+1;
            t.type = TOK_EQUALSEQUALS;
        }
    }
    if t.type < 0 {
        error("unknown token");
    }
    return t;
}

fn lex_iden(src:*char) Token {
    c:int = 0;
    xd:bool  = is_alpha(src[c]) || is_digit(src[c]) || (src[c] == '_');

    while (is_alpha(src[c]) || is_digit(src[c]) || (src[c] == '_')) {
        c = c+1;
    }

    t:Token;
    t.text_len = c;
    t.text = src;

    t.type = -1;

    if c == 2 {
        if streq(src, "if", c) { t.type = TOK_KW_IF; }
        if streq(src, "fn", c) { t.type = TOK_KW_FN; }
    }
    if c == 3 {
        if streq(src, "var", c) { t.type = TOK_KW_VAR; }
        if streq(src, "int", c) { t.type = TOK_TY_INT; }
    }
    if c == 4 {
        if streq(src, "char", c) { t.type = TOK_TY_CHAR; }
        if streq(src, "void", c) { t.type = TOK_TY_VOID; }
        if streq(src, "bool", c) { t.type = TOK_TY_BOOL; }
        if streq(src, "true", c) { t.type = TOK_LIT_BOOL; }
    }
    if c == 5 {
        if streq(src, "const", c) { t.type = TOK_KW_CONST; }
        if streq(src, "while", c) { t.type = TOK_KW_WHILE; }
        if streq(src, "break", c) { t.type = TOK_KW_BREAK; }
        if streq(src, "false", c) { t.type = TOK_LIT_BOOL; }
    }
    if c == 6 {
        if streq(src, "struct", c) { t.type = TOK_KW_STRUCT; }
        if streq(src, "return", c) { t.type = TOK_KW_RETURN; }
    }
    if c == 8 {
        if streq(src, "continue", c) { t.type = TOK_KW_CONTINUE; }
    }
    if (t.type < 0) { t.type = TOK_IDEN; }

    return t;
}

fn lex_string(src:*char) Token {
    t:Token;
    t.text_len = 0;
    t.text = src;
    t.type = TOK_LIT_STRING;
    while true {
        t.text_len = t.text_len+1;
        if src[t.text_len] == '\0' { error("unfinished string literal"); }
        if (src[t.text_len] == '\\' 
        && src[t.text_len + 1] != '\0' 
        && src[t.text_len + 1] == '"') {
            t.text_len=t.text_len+1;
            continue;
        }
        if src[t.text_len] == '"' { break; }
    }
    t.text_len = t.text_len+1;
    return t;
}

fn lex_char(src: *char) Token {
    t:Token;
    t.type = TOK_LIT_CHAR;
    t.text_len = 2;
    t.text = src;
    if (src[1] == '\\') {
        valid_escape:bool = false;
        if (src[2] == 'n' || src[2] == 'r' ||
            src[2] == 't' || src[2] == '\\' ||
            src[2] == '0' || src[2] == '\'') {
            t.text_len = t.text_len+1;
            valid_escape = true;
        }
        if !valid_escape { error("unrecognized scaped character"); }
    }
  
    if src[t.text_len] != '\'' { 
        error("expected closing '");
    }

    t.text_len = t.text_len+1;
    return t;
}

fn lex_num(src: *char) Token {
    len:int = 0;
    while is_digit(src[len]) { len = len+1; }

    t:Token;
    t.type = TOK_LIT_INT;
    t.text_len = len;
    t.text = src;
    return t;
}

fn len_skip_comments(src:*char) int {
    if src[0] == '\0' || src[1] == '\0' { return 0; }
    if src[0] != '/' || src[1] != '/' { return 0; }

    i:int = 2;
    while true {
        if src[i] == '\n' || src[i] == '\0' { break; }
        i=i+1;
    }
    return i;
}

fn lex_token(src:**char) Token {
    ref:*char = 0;
    while ref != *src {
        ref = *src;
        while is_whitespace(**src) {
            *src = *src + 1;
        }
        *src = *src + len_skip_comments(*src);
    }
    t:Token = peek_token(*src);
    *src = *src + t.text_len;
    return t;
}

////////////////////////////////////
// AST                            //
////////////////////////////////////

///// TYPES ////////////////////////

const TYPE_VOID:int = 1;
const TYPE_BOOL:int = 2;
const TYPE_INT:int  = 3;
const TYPE_CHAR:int = 4;

const TYPE_KIND_BASE:int   = 1;
const TYPE_KIND_PTR:int    = 2;
const TYPE_KIND_STRUCT:int = 3;

struct TypeStructDef {
    name:*char;
    name_len:int;
    field_names:**char;
    field_name_lens:*int;
    types:*Type;
    n_fields:int;
    sizeb:int;
}
const SIZEOF_TypeStructDef:int = 56;

struct TypeStructName {
    name:*char;
    name_len:int;
    sym_idx:int;
}

struct Type {
    kind:int;
    base:int;
    ptr:*Type;
    struct_name:TypeStructName;
}
const SIZEOF_Type:int = 48;

///// EXPRESSIONS //////////////////

const AST_EXPR_LIT_BOOL:int   = 0;
const AST_EXPR_LIT_CHAR:int   = 1;
const AST_EXPR_LIT_INT:int    = 2;
const AST_EXPR_LIT_STRING:int = 3;
const AST_EXPR_VAR:int        = 4;
const AST_EXPR_BINOP:int      = 5;
const AST_EXPR_UNOP:int       = 6;
const AST_EXPR_CALL:int       = 7;

struct AST_Expr_Var {
    name:*char;
    name_len:int;
    sym_idx:int;
}

struct AST_Expr_Lit_Int {
    value:int;
}

struct AST_Expr_Lit_Bool {
    value:int;
}

struct AST_Expr_Lit_String {
    text:*char;
}

struct AST_Expr_Lit_Char {
    value:char;
}

struct AST_Expr_Binop {
    op:int;
    left:*AST_Expr;
    right:*AST_Expr;
    offsetb:int;
}

struct AST_Expr_Unop {
    op:int;
    expr:*AST_Expr;
}

struct AST_Expr_Call {
    fun_expr:*AST_Expr;
    args:*AST_Expr;
    args_len:int;
    is_syscall:bool;
    temporary_sym_idxs:*int;
    temporary_sret_sym_idx:int;
}

struct AST_Expr {
    kind:int;
    varr:AST_Expr_Var;
    lit_int:AST_Expr_Lit_Int;
    lit_bool:AST_Expr_Lit_Bool;
    lit_string:AST_Expr_Lit_String;
    lit_char:AST_Expr_Lit_Char;
    binop:AST_Expr_Binop;
    unop:AST_Expr_Unop;
    call:AST_Expr_Call;
    ty:Type;
}
const SIZEOF_AST_Expr:int = 208;

///// STATEMENTS ///////////////////

const AST_STMT_DEFINE:int   = 0;
const AST_STMT_ASSIGN:int   = 1;
const AST_STMT_IF:int       = 2;
const AST_STMT_WHILE:int    = 3;
const AST_STMT_RETURN:int   = 4;
const AST_STMT_RAW_EXPR:int = 5;
const AST_STMT_BREAK:int    = 6;
const AST_STMT_CONTINUE:int = 7;

struct Block {
    stmts:*AST_Stmt;
    stmts_len:int;
    stmt_cap:int;
}
const SIZEOF_Block:int = 24;

struct AST_Stmt_Assign {
    lvalue:AST_Expr;
    rvalue:AST_Expr;
    sym_idx:int;
    t:Type;
}

struct AST_Stmt_Declare {
    var_name:*char;
    var_name_len:int;
    t:Type;
    expr:*AST_Expr;
    sym_idx:int;
}

struct AST_Stmt_If {
    cond:*AST_Expr;
    block:*Block;
}

struct AST_Stmt_While {
    cond:*AST_Expr;
    block:*Block;
}

struct AST_Stmt_Return {
    expr:*AST_Expr;
    sret_idx:int;
}

struct AST_Stmt {
    kind:int;
    assign:AST_Stmt_Assign;
    define:AST_Stmt_Declare;
    iff:AST_Stmt_If;
    whilee:AST_Stmt_While;
    returnn:AST_Stmt_Return;
    raw_expr:AST_Expr;
}
const SIZEOF_AST_Stmt:int = 816;

///// DEFINITIONS //////////////////

const AST_DEF_FUN:int   = 0;
const AST_DEF_CONST:int = 1;
const AST_DEF_VAR:int   = 2;
const AST_DEF_TYPE:int  = 3;

struct AST_Def_Fun {
    name:*char;
    name_len:int;
    num_args:int;
    arg_names:**char;
    arg_name_lens:*int;
    arg_types:*Type;
    return_type:Type;
    block:Block;
    arg_sym_idxs:*int;
    locals_stack_size:int;
    sret_sym_idx:int;
}

struct AST_Def {
    kind:int;
    fun:AST_Def_Fun;
    global:AST_Stmt_Declare;
    stru:TypeStructDef;
}
const SIZEOF_AST_Def:int = 288;

///// AST //////////////////////////

struct AST {
  defs:*AST_Def;
  defs_len:int;
}

///// AST UTILS ////////////////////

fn ast_new_base_type(bt:int) Type {
  t:Type;
  t.kind = TYPE_KIND_BASE;
  t.base = bt;
  return t;
}

fn ast_new_ptr_type(inner_t:Type) Type {
  t:Type;
  t.kind = TYPE_KIND_PTR;
  t.ptr = alloc(SIZEOF_Type);
  *t.ptr = inner_t;
  return t;
}

////////////////////////////////////
// PARSER                         //
////////////////////////////////////

fn parse_var(t:Token) AST_Expr {
    e:AST_Expr;
    e.kind = AST_EXPR_VAR;
    e.varr.name = t.text;
    e.varr.name_len = t.text_len;
    e.varr.sym_idx = -1;
    return e;
}

fn parse_lit_char(t:Token) AST_Expr {
    e:AST_Expr;
    e.kind = AST_EXPR_LIT_CHAR;
    if t.text[1] != '\\' {
        e.lit_char.value = t.text[1];
        return e;
    }
    
    if t.text[2] == '\'' { e.lit_char.value = '\''; }
    if t.text[2] == '\\' { e.lit_char.value = '\\'; }
    if t.text[2] == 'n'  { e.lit_char.value = '\n'; }
    if t.text[2] == 't'  { e.lit_char.value = '\t'; }
    if t.text[2] == 'r'  { e.lit_char.value = '\r'; }
    if t.text[2] == '0'  { e.lit_char.value = '\0'; }

    return e;
}

fn parse_lit_string(t:Token) AST_Expr {
    e:AST_Expr;
    e.kind = AST_EXPR_LIT_STRING;
    e.lit_string.text = alloc(t.text_len - 1);

    dest_i:int = 0;
    i:int = 1;
    while (i < t.text_len - 1) {
        c:char = t.text[i];
        if c != '\\' {
            e.lit_string.text[dest_i] = c;
            dest_i = dest_i + 1;
            i = i+1;
            continue;
        }
        i = i+1;
        if t.text[i] == 'n' { e.lit_string.text[dest_i] = '\n'; }
        if t.text[i] == '"' { e.lit_string.text[dest_i] = '"'; }
        if t.text[i] == 't' { e.lit_string.text[dest_i] = '\t'; }
        if t.text[i] == 'r' { e.lit_string.text[dest_i] = '\r'; }
        if t.text[i] == '0' { e.lit_string.text[dest_i] = '\0'; }
        dest_i = dest_i+1;
        i=i+1;
    }
    e.lit_string.text[dest_i] = '\0';
    return e;
}

fn parse_lit_bool(t:Token) AST_Expr {
    e:AST_Expr;
    e.kind = AST_EXPR_LIT_BOOL;
    if streq(t.text, "true", 4) {
        e.lit_bool.value = 1;
        return e;
    } 
    if streq(t.text, "false", 5) {
        e.lit_bool.value = 0;
        return e;
    }
    error("invalid boolean literal");
    return e; // unreachable
}

fn parse_lit_int(t:Token) AST_Expr {
    e:AST_Expr;

    num:int = 0;
    i:int = 0;
    while i < t.text_len {
        num = num * 10;
        if t.text[i] == '0' { num=num+0; }
        if t.text[i] == '1' { num=num+1; }
        if t.text[i] == '2' { num=num+2; }
        if t.text[i] == '3' { num=num+3; }
        if t.text[i] == '4' { num=num+4; }
        if t.text[i] == '5' { num=num+5; }
        if t.text[i] == '6' { num=num+6; }
        if t.text[i] == '7' { num=num+7; }
        if t.text[i] == '8' { num=num+8; }
        if t.text[i] == '9' { num=num+9; }
        i=i+1;
    }
    e:AST_Expr;
    e.kind = AST_EXPR_LIT_INT;
    e.lit_int.value = num;
    return e;
}

fn parse_call(src:**char, t:Token, fun_expr:AST_Expr) AST_Expr {
    expr:AST_Expr;
    expr.kind = AST_EXPR_CALL;

    assert(fun_expr.kind == AST_EXPR_VAR);
    expr.call.fun_expr = alloc(SIZEOF_AST_Expr);
    *expr.call.fun_expr = fun_expr;
    expr.call.is_syscall = fun_expr.varr.name_len == 7 &&
                           streq(fun_expr.varr.name, "syscall", 7);

    t = lex_token(src);
    if t.type != TOK_LPAREN { error("Expected '('"); }

    args_cap:int = 2;
    expr.call.args = alloc(args_cap * SIZEOF_AST_Expr);
    expr.call.args_len = 0;
    while true {
        t = lex_token(src);
        if t.type == TOK_RPAREN { break; }
        if t.type == TOK_EOF { error("Expected ')' or expression but found EOF"); }
        if expr.call.args_len >= args_cap {
            args_cap = args_cap * 2;
            expr.call.args = realloc(expr.call.args, args_cap * SIZEOF_AST_Expr);
        }

        expr.call.args[expr.call.args_len] = parse_expr(src, t);
        expr.call.args_len = expr.call.args_len+1;
        t = lex_token(src);
        if t.type == TOK_COMMA { continue; }
        if t.type == TOK_RPAREN { break; }
        error("Expected ',' or ')'");
    }
    return expr;
}

fn prefix_prec(ttype:int) int {
    if ttype == TOK_BANG      { return 20; }
    if ttype == TOK_TILDE     { return 20; }
    if ttype == TOK_PLUS      { return 20; }
    if ttype == TOK_MINUS     { return 20; }
    if ttype == TOK_AMPERSAND { return 20; }
    if ttype == TOK_ASTERISK  { return 20; }
    return 0;
}
 
fn postfix_prec(ttype:int) int {
    if ttype == TOK_LPAREN { return 10; }
    if ttype == TOK_LSQBR  { return 10; }
    return 0;
}

fn infix_prec(ttype:int) int {
    if ttype == TOK_PERIOD       { return 10; }
    if ttype == TOK_ASTERISK     { return 40; }
    if ttype == TOK_SLASH        { return 40; }
    if ttype == TOK_PERCENT      { return 40; }
    if ttype == TOK_PLUS         { return 50; }
    if ttype == TOK_MINUS        { return 50; }
    if ttype == TOK_SHIFT_LEFT   { return 60; }
    if ttype == TOK_SHIFT_RIGHT  { return 60; }
    if ttype == TOK_LT           { return 70; }
    if ttype == TOK_LTE          { return 70; }
    if ttype == TOK_GT           { return 70; }
    if ttype == TOK_GTE          { return 70; }
    if ttype == TOK_EQUALSEQUALS { return 80; }
    if ttype == TOK_BANGEQUALS   { return 80; }
    if ttype == TOK_AMPERSAND    { return 90; }
    if ttype == TOK_BIT_OR       { return 100; }
    if ttype == TOK_AND          { return 110; }
    if ttype == TOK_OR           { return 120; }
    return 0;
}
const MAX_PREC:int = 999;

fn parse_expr_with_prec(src:**char, t:Token, prec:int) AST_Expr {
    left:AST_Expr;

    left.kind = -1; 
    if t.type == TOK_LIT_INT { left = parse_lit_int(t); }
    if t.type == TOK_LIT_BOOL { left = parse_lit_bool(t); }
    if t.type == TOK_LIT_STRING { left = parse_lit_string(t); }
    if t.type == TOK_LIT_CHAR { left = parse_lit_char(t); }
    if t.type == TOK_IDEN { left = parse_var(t); }
    if t.type == TOK_LPAREN {
        t = lex_token(src);
        left = parse_expr(src, t);
        t = lex_token(src);
        if t.type != TOK_RPAREN { error("Expected ')' :("); }
    }

    pre_prec:int = prefix_prec(t.type);
    if left.kind < 0 && pre_prec != 0 {
        left.kind = AST_EXPR_UNOP;
        left.unop.op = t.type;
        t = lex_token(src);
        left.unop.expr = alloc(SIZEOF_AST_Expr);
        *left.unop.expr = parse_expr_with_prec(src, t, pre_prec);
    }

    op:Token;
    res:AST_Expr = left;

    while true {
        op = peek_token(*src);
        // postfix operators:
        postf_prec:int = postfix_prec(op.type);
        if postf_prec != 0 {
            if postf_prec >= prec { break; }
            
            if op.type == TOK_LPAREN {
                res = parse_call(src, t, left);
                continue;
            }
            if op.type == TOK_LSQBR {
                lex_token(src);
                t = lex_token(src);
                new_res:AST_Expr;
                new_res.kind = AST_EXPR_BINOP;
                new_res.binop.left = alloc(SIZEOF_AST_Expr);
                *new_res.binop.left = res;
                new_res.binop.op = op.type;
                new_res.binop.right = alloc(SIZEOF_AST_Expr);
                *new_res.binop.right = parse_expr(src, t);
                t = lex_token(src);
                if t.type != TOK_RSQBR { error("Missing closing ']'"); }
                res = new_res;
            }
            continue;
        }

        // infix operators:
        inf_prec:int  = infix_prec(op.type);
        if inf_prec != 0 {
            if inf_prec >= prec { break; }

            t = lex_token(src);
            new_res:AST_Expr;
            new_res.kind = AST_EXPR_BINOP;
            new_res.binop.left = alloc(SIZEOF_AST_Expr);
            *new_res.binop.left = res;
            new_res.binop.op = t.type;

            t = lex_token(src);
            new_res.binop.right = alloc(SIZEOF_AST_Expr);
            *new_res.binop.right = parse_expr_with_prec(src, t, inf_prec);
            res = new_res;
            continue;
        }
        break;
    }
    return res;
    return left;
}

fn parse_expr(src:**char, t:Token) AST_Expr {
    return parse_expr_with_prec(src, t, MAX_PREC);
}

fn parse_type(src:**char, t:Token) Type {
    if t.type == TOK_ASTERISK {
        t = lex_token(src);
        return ast_new_ptr_type(parse_type(src, t));
    }
    if t.type == TOK_IDEN {
        ty:Type;
        ty.kind = TYPE_KIND_STRUCT;
        ty.struct_name.name = t.text;
        ty.struct_name.name_len = t.text_len;
        return ty;
    }

    bt:int = -1;
    if t.type == TOK_TY_VOID { bt = TYPE_VOID; }
    if t.type == TOK_TY_CHAR { bt = TYPE_CHAR; }
    if t.type == TOK_TY_BOOL { bt = TYPE_BOOL; }
    if t.type == TOK_TY_INT { bt = TYPE_INT; }
    if bt < 0 { error("Expected type"); }
    ty:Type = ast_new_base_type(bt);
    return ty;
}

fn parse_stmt_define(src:**char, t:Token) AST_Stmt {
    stmt:AST_Stmt;
    stmt.kind = AST_STMT_DEFINE;
    stmt.define.var_name = t.text;
    stmt.define.var_name_len = t.text_len;

    lex_token(src); // skip the ':' (should already be checked for)
    t = lex_token(src);

    found_type:bool=false;
    if t.type == TOK_TY_BOOL ||
        t.type == TOK_TY_INT ||
        t.type == TOK_TY_VOID ||
        t.type == TOK_TY_CHAR ||
        t.type == TOK_ASTERISK ||
        t.type == TOK_IDEN {
        stmt.define.t = parse_type(src, t);
        found_type = true;
    }
    if !found_type { error("Expected type after ':'"); }

    t = lex_token(src);
    if t.type == TOK_SEMICOLON {
        stmt.define.expr = 0;
        return stmt;
    }
    if t.type != TOK_EQUALS { error("Expected '=' after type in definition"); }
    t = lex_token(src);
    stmt.define.expr = alloc(SIZEOF_AST_Expr);
    *stmt.define.expr = parse_expr(src, t);
    t = lex_token(src);
    if t.type != TOK_SEMICOLON { error("Expected ';'"); }
    return stmt;
}

fn parse_stmt_assign_or_raw_expr(src:**char, t:Token) AST_Stmt {
    stmt:AST_Stmt;
    lvalue:AST_Expr = parse_expr(src, t);

    t = lex_token(src);

    if t.type == TOK_SEMICOLON {
        stmt.kind = AST_STMT_RAW_EXPR;
        stmt.raw_expr = lvalue;
        return stmt;
    }

    if t.type != TOK_EQUALS { error("Expected '=' or ';' after lvalue"); }

    stmt.kind = AST_STMT_ASSIGN;
    stmt.assign.lvalue = lvalue;
    t = lex_token(src);
    stmt.assign.rvalue = parse_expr(src, t);
    t = lex_token(src);
    if t.type != TOK_SEMICOLON { error("Expected ';'"); }
    return stmt;
}

fn parse_stmt_while(src:**char, t:Token) AST_Stmt {
    stmt:AST_Stmt;
    stmt.kind = AST_STMT_WHILE;
    t = lex_token(src);
    stmt.whilee.cond = alloc(SIZEOF_AST_Expr);
    *stmt.whilee.cond = parse_expr(src, t);
    t = lex_token(src);
    stmt.whilee.block = alloc(SIZEOF_Block);
    *stmt.whilee.block = parse_block(src, t);
    return stmt;
}

fn parse_stmt_if(src:**char, t:Token) AST_Stmt {
    stmt:AST_Stmt;
    stmt.kind = AST_STMT_IF;
    t = lex_token(src);
    stmt.iff.cond = alloc(SIZEOF_AST_Expr);
    *stmt.iff.cond = parse_expr(src, t);
    stmt.iff.block = alloc(SIZEOF_Block);
    t = lex_token(src);
    *stmt.iff.block = parse_block(src, t);
    return stmt;
}

fn parse_stmt_return(src:**char, t:Token) AST_Stmt {
    stmt:AST_Stmt;
    stmt.kind = AST_STMT_RETURN;
    t = lex_token(src);
    if t.type == TOK_SEMICOLON {
        stmt.returnn.expr = 0;
        return stmt;
    }
    stmt.returnn.expr = alloc(SIZEOF_AST_Expr);
    *stmt.returnn.expr = parse_expr(src, t);
    t = lex_token(src);
    if t.type != TOK_SEMICOLON { error("Expected ';'"); }
    return stmt;
}

fn parse_stmt(src:**char, t:Token) AST_Stmt {
    s:AST_Stmt;
    if t.type == TOK_KW_BREAK {
        t = lex_token(src);
        if t.type != TOK_SEMICOLON { error("expected semicolon after break"); }
        s.kind = AST_STMT_BREAK;
        return s;
    }
    if t.type == TOK_KW_CONTINUE {
        t = lex_token(src);
        if t.type != TOK_SEMICOLON { error("expected semicolon after continue"); }
        s.kind = AST_STMT_CONTINUE;
        return s;
    }
    if t.type == TOK_KW_RETURN { return parse_stmt_return(src, t); }
    if t.type == TOK_KW_IF { return parse_stmt_if(src, t); }
    if t.type == TOK_KW_WHILE { return parse_stmt_while(src, t); }
    if t.type == TOK_IDEN {
        pt:Token = peek_token(*src);
        if pt.type == TOK_COLON {
            return parse_stmt_define(src, t);
        }
        return parse_stmt_assign_or_raw_expr(src, t);
    }
    if t.type == TOK_ASTERISK { return parse_stmt_assign_or_raw_expr(src, t); }

    error("invalid statement");
    return s; // unreachable
}

fn parse_block(src:**char, t:Token) Block {
    if t.type != TOK_LCURLY { error("Blocks should start with '{'"); }
    b:Block;
    b.stmts_len = 0;
    b.stmt_cap = 4;
    b.stmts = alloc(b.stmt_cap * SIZEOF_AST_Stmt);
    while true {
        t = lex_token(src);
        if t.type == TOK_RCURLY { break; }
        if t.type == TOK_EOF { error("Expected '}' or statement"); }
        if b.stmts_len >= b.stmt_cap {
            b.stmt_cap = b.stmt_cap * 2;
            b.stmts = realloc(b.stmts, b.stmt_cap * SIZEOF_AST_Stmt);
        }
        b.stmts[b.stmts_len] = parse_stmt(src, t);
        b.stmts_len = b.stmts_len+1;
    }
    return b;
}

fn parse_def_fun(src:**char, t:Token) AST_Def {
    def:AST_Def;
    def.kind = AST_DEF_FUN;

    fun:*AST_Def_Fun = &def.fun;

    // parse name
    t = lex_token(src);
    fun.name = t.text;
    fun.name_len = t.text_len;
    t = lex_token(src);
    if t.type != TOK_LPAREN { error("Expected '('"); }

    // parse args
    arg_names_cap:int = 2;
    fun.num_args = 0;
    fun.arg_names = alloc(arg_names_cap * 8);
    fun.arg_name_lens = alloc(arg_names_cap * 8);
    fun.arg_types = alloc(arg_names_cap * SIZEOF_Type);
    fun.arg_sym_idxs = alloc(arg_names_cap * 8);

    while true {
        t = lex_token(src);
        if t.type == TOK_RPAREN { break; }
        if t.type == TOK_EOF { error("Expected ')' or fun arg but reached EOF"); }
        if t.type != TOK_IDEN { error("Expected Identifier"); }
        if fun.num_args >= arg_names_cap {
            arg_names_cap = arg_names_cap*2;
            fun.arg_names = realloc(fun.arg_names, arg_names_cap * 8);
            fun.arg_name_lens = realloc(fun.arg_name_lens, arg_names_cap * 8);
            fun.arg_types = realloc(fun.arg_types, arg_names_cap * SIZEOF_Type);
            fun.arg_sym_idxs = realloc(fun.arg_sym_idxs, arg_names_cap * SIZEOF_Type);
        }
        fun.arg_names[fun.num_args] = t.text;
        fun.arg_name_lens[fun.num_args] = t.text_len;

        t = lex_token(src);
        if t.type != TOK_COLON { error("expected ':'"); }

        t = lex_token(src);
        ty:Type = parse_type(src, t);
        fun.arg_types[fun.num_args] = ty;
        fun.num_args = fun.num_args + 1;

        t = lex_token(src);
        if t.type == TOK_COMMA { continue; }
        if t.type == TOK_RPAREN { break; }
        error("Expected ',' or ')' in function signature");
    }

    t = lex_token(src);
    if t.type == TOK_LCURLY {
        void_t:Type;
        void_t.kind = TYPE_KIND_BASE;
        void_t.base = TYPE_VOID;
        fun.return_type = void_t;
    }
    if t.type != TOK_LCURLY {
        fun.return_type = parse_type(src, t);
        t = lex_token(src);
    }

    fun.block = parse_block(src, t);
    return def;
}

fn parse_def_varconst(src:**char, t:Token) AST_Def {
    d:AST_Def;
    if t.type == TOK_KW_CONST { d.kind = AST_DEF_CONST; }
    if t.type == TOK_KW_VAR { d.kind = AST_DEF_VAR; }

    t = lex_token(src);

    stmt:AST_Stmt = parse_stmt_define(src, t);
    kind:int = stmt.define.expr.kind;
    if kind != AST_EXPR_LIT_INT && kind != AST_EXPR_LIT_STRING &&
        kind != AST_EXPR_LIT_CHAR && kind != AST_EXPR_LIT_BOOL {
        error("consts can't be anything other than literals");
    }
    d.global = stmt.define;
    // render_define(d.global);
    return d;
}

fn parse_def_struct(src:**char, t:Token) AST_Def {
    def:AST_Def;
    def.kind = AST_DEF_TYPE;
    t = lex_token(src);
    if t.type != TOK_IDEN { error("Expected identifier after 'struct'"); }
    def.stru.name = t.text;
    def.stru.name_len = t.text_len;
    t = lex_token(src);
    if t.type != TOK_LCURLY { error("Expected '{' after struct identifier"); }

    cap:int = 2;
    def.stru.field_names = alloc(cap * 8);
    def.stru.field_name_lens = alloc(cap * 8);
    def.stru.types = alloc(cap * SIZEOF_Type);

    n_args:int  = 0;
    while (true) {
        if n_args >= cap {
            cap = cap * 2;
            def.stru.field_names = realloc(def.stru.field_names, cap*8);
            def.stru.field_name_lens = realloc(def.stru.field_name_lens, cap * 8);
            def.stru.types = realloc(def.stru.types, cap * SIZEOF_Type);
        }
        t = lex_token(src);
        if t.type == TOK_RCURLY { break; }
        if t.type != TOK_IDEN { error("Expected identifier in struct definition"); }
        def.stru.field_names[n_args] = t.text;
        def.stru.field_name_lens[n_args] = t.text_len;

        t = lex_token(src);
        if t.type != TOK_COLON { error("Expected ':' after identifier in struct definition"); }
        t = lex_token(src);
        def.stru.types[n_args] = parse_type(src, t);
        t = lex_token(src);
        if t.type != TOK_SEMICOLON { error("Expected ';' after type in struct definition"); }
        n_args = n_args + 1;
    }

    def.stru.n_fields = n_args;
    return def;
}

fn parse_def(src:**char, t:Token) AST_Def {
    if t.type == TOK_KW_CONST || t.type == TOK_KW_VAR {
        return parse_def_varconst(src, t);
    }
    if t.type == TOK_KW_STRUCT { return parse_def_struct(src, t); }
    if t.type == TOK_KW_FN { return parse_def_fun(src, t); }
  
    error("Expected function definition starting with fn");
    d:AST_Def; // unreachable
    return d;
}

fn parse(src:**char) AST{
    ast:AST;
    cap:int = 2;
    ast.defs = alloc(cap * SIZEOF_AST_Def);
    ast.defs_len = 0;
    t:Token;
    while true {
        t = lex_token(src);
        if t.type == TOK_EOF { break; }
        if ast.defs_len >= cap { 
            cap = cap * 2;
            ast.defs = realloc(ast.defs, cap * SIZEOF_AST_Def);
        }
        ast.defs[ast.defs_len] = parse_def(src, t);
        ast.defs_len = ast.defs_len+1;
    }
    return ast;
}

////////////////////////////////////
// RENDER AST                     //
////////////////////////////////////

var IND:int = 0;
fn ind() {
    i:int=0;
    println("");
    while i < IND {
        print("  ");
        i=i+1;
    }
}


fn render_type(t:Type) {
    ind();
    print("(Type ");
    while (t.kind == TYPE_KIND_PTR) {
        print("*");
        t = *t.ptr;
    }
    if (t.kind == TYPE_KIND_STRUCT) {
        write(t.struct_name.name,
              t.struct_name.name_len);
        print(" tidx:(");
        print(fmt_dec(t.struct_name.sym_idx));
    }
    if (t.kind == TYPE_KIND_BASE) {
        if t.base == TYPE_VOID { print("void"); }
        if t.base == TYPE_INT  { print("int"); }
        if t.base == TYPE_CHAR { print("char"); }
        if t.base == TYPE_BOOL { print("bool"); }
    }
    print(")");
}

fn render_lit_string(l:AST_Expr_Lit_String) {
    print("(LIT_STRING '");
    print(l.text);
    print("')");
}

fn render_lit_char(l:AST_Expr_Lit_Char) {
    print("(LIT_CHAR '");
    escaped:bool = false;
    if l.value == '\0' {print("%0"); escaped=true;}
    if l.value == '\t' {print("%t"); escaped=true;}
    if l.value == '\n' {print("%n"); escaped=true;}
    if l.value == '\r' {print("%r"); escaped=true;}
    if l.value == '\'' {print("'"); escaped=true;}
    if !escaped {
        bfr:*char = alloc(2);
        bfr[0]=l.value;
        print(bfr);
    }
    print("')");
}

fn render_lit_int(l:AST_Expr_Lit_Int) {
    print("(LIT_INT ");
    print(fmt_dec(l.value));
    print(")");
}

fn render_lit_bool(l:AST_Expr_Lit_Bool) {
    print("(LIT_BOOL ");
    if (l.value == 0) { print("false"); }
    if (l.value != 0) { print("true"); }
    print(")");
}

fn render_expr_var(v:AST_Expr_Var) {
    print("(VAR '");
    write(v.name, v.name_len);
    print("'");
    print(" sidx:");
    print(fmt_dec(v.sym_idx));
    print(")");
}

fn render_expr_call(c:AST_Expr_Call) {
    print("(CALL");
    IND=IND+1;
    render_expr(*c.fun_expr);
    i:int = 0;
    while i < c.args_len {
        render_expr(c.args[i]);
        i=i+1;
    }
    IND=IND-1;
    print(")");
}

fn render_unop(u:AST_Expr_Unop) {
    ind();
    print("(UNOP ");
    render_op(u.op);
    IND=IND+1;
    render_expr(*u.expr);
    IND=IND-1;
    print("')");
}

fn render_op(op:int) {
    if op == TOK_LSQBR { print("[]"); }
    if op == TOK_LPAREN { print("(call)"); }
    if op == TOK_BANG { print("!"); }
    if op == TOK_TILDE { print("~"); }
    if op == TOK_EQUALSEQUALS { print("=="); }
    if op == TOK_BANGEQUALS { print("!="); }
    if op == TOK_GT { print(">"); }
    if op == TOK_GTE { print(">="); }
    if op == TOK_LT { print("<"); }
    if op == TOK_LTE { print("<="); }
    if op == TOK_AND { print("&&"); }
    if op == TOK_OR { print("||"); }
    if op == TOK_BIT_OR { print("|"); }
    if op == TOK_AMPERSAND { print("&"); }
    if op == TOK_PLUS { print("+"); }
    if op == TOK_MINUS { print("-"); }
    if op == TOK_SHIFT_LEFT { print(">>"); }
    if op == TOK_SHIFT_RIGHT { print("<<"); }
    if op == TOK_ASTERISK { print("*"); }
    if op == TOK_PERCENT { print("%"); }
    if op == TOK_SLASH { print("/"); }
    if op == TOK_PERIOD { print("."); }
}
fn render_binop(b:AST_Expr_Binop) {
    ind();
    print("(BINOP ");
    render_op(b.op);
    IND=IND+1;
    render_expr(*b.left);
    render_expr(*b.right);
    IND=IND-1;
    print("')");
}

fn render_expr(e:AST_Expr) {
    ind();
    print("(EXPR ");
    IND=IND+1;
    should_render_type:bool = true;
    if (e.kind == AST_EXPR_VAR) {
        if (e.varr.sym_idx == -1) {
            should_render_type=false;
            print("(NOTYPE)");
        }
    }
    if should_render_type {
        render_type(e.ty);
    }
    if e.kind == AST_EXPR_LIT_INT { render_lit_int(e.lit_int); }
    if e.kind == AST_EXPR_LIT_BOOL { render_lit_bool(e.lit_bool); }
    if e.kind == AST_EXPR_LIT_STRING { render_lit_string(e.lit_string); }
    if e.kind == AST_EXPR_LIT_CHAR { render_lit_char(e.lit_char); }
    if e.kind == AST_EXPR_VAR { render_expr_var(e.varr); }
    if e.kind == AST_EXPR_BINOP { render_binop(e.binop); }
    if e.kind == AST_EXPR_UNOP { render_unop(e.unop); }
    if e.kind == AST_EXPR_CALL { render_expr_call(e.call); }
    IND=IND-1;
    print(")");
}

fn render_const_def(d:AST_Stmt_Declare) {
    ind();
    print("(CONST '");
    write(d.var_name, d.var_name_len);
    print("'");
    IND=IND+1;
    render_type(d.t);
    render_expr(*d.expr);
    IND=IND-1;
    print(")");
}

fn render_var_def(d:AST_Stmt_Declare) {
    ind();
    print("(VAR '");
    write(d.var_name, d.var_name_len);
    print("'");
    IND=IND+1;
    render_type(d.t);
    render_expr(*d.expr);
    IND=IND-1;
    print(")");
}

fn render_define(d:AST_Stmt_Declare) {
    ind();
    print("(DEFINE '");
    write(d.var_name, d.var_name_len);
    print("'");
    IND=IND+1;
    render_type(d.t);
    if (d.expr != 0) {
        render_expr(*d.expr);
    }
    if d.expr == 0 {
        ind();
        print("(NOEXPR)");
    }
    IND=IND-1;
    print(")");
}
fn render_assign(a:AST_Stmt_Assign) {
    ind();
    print("(ASSIGN ");
    IND=IND+1;
    render_expr(a.lvalue);
    render_expr(a.rvalue);
    IND=IND-1;
    print(")");
}
fn render_if(i:AST_Stmt_If) {
    ind();
    print("(IF ");
    IND=IND+1;
    render_expr(*i.cond);
    render_block(*i.block);
    IND=IND-1;
    print(")");
}
fn render_while(w:AST_Stmt_While) {
    ind();
    print("(WHILE ");
    IND=IND+1;
    render_expr(*w.cond);
    render_block(*w.block);
    IND=IND-1;
    print(")");
}
fn render_return(r:AST_Stmt_Return) {
    ind();
    print("(RETURN ");
    IND=IND+1;
    if r.expr != 0 {
        render_expr(*r.expr);
    }
    if r.expr == 0 {
        ind();
        print("(NOEXPR)");
    }
    IND=IND-1;
    print(")");
}

fn render_stmt(s:AST_Stmt) {
    if s.kind == AST_STMT_DEFINE {render_define(s.define); return; }
    if s.kind == AST_STMT_ASSIGN {render_assign(s.assign); return; }
    if s.kind == AST_STMT_IF {render_if(s.iff); return; }
    if s.kind == AST_STMT_WHILE {render_while(s.whilee); return; }
    if s.kind == AST_STMT_RETURN {render_return(s.returnn); return; }
    if s.kind == AST_STMT_RAW_EXPR {render_expr(s.raw_expr); return; }
    if s.kind == AST_STMT_BREAK {print("(BREAK)"); return; }
    if s.kind == AST_STMT_CONTINUE {print("(CONTINUE)"); return; }
    println(fmt_hex(s.kind));
    error("unknown stmt kind for render");
}

fn render_block(b:Block) {
    i:int = 0;
    while i < b.stmts_len {
        render_stmt(b.stmts[i]);
        i=i+1;
    }
}
fn render_fun_def(fun:AST_Def_Fun) {
    ind();
    print("(FUNDEF ");
    write(fun.name, fun.name_len);
    IND=IND+1;
    i:int=0;
    print(" nargs:");
    print(fmt_dec(fun.num_args));
    render_type(fun.return_type);
    while i < fun.num_args {
        ind();
        print("(ARG ");
        write(fun.arg_names[i], fun.arg_name_lens[i]);
        IND=IND+1;
        render_type(fun.arg_types[i]);
        IND=IND-1;
        print(")");
        i=i+1;
    }
    i=0;
    render_block(fun.block);
    IND=IND-1;
    print(")");
}

fn render_type_def(ts:TypeStructDef) {
    ind();
    print("(TYPEDEF ");
    write(ts.name, ts.name_len);
    print(" nfields:");
    print(fmt_dec(ts.n_fields));
    IND=IND+1;
    i:int=0;
    while i < ts.n_fields {
        ind();
        print("(FIELD ");
        write(ts.field_names[i], 
              ts.field_name_lens[i]);
        IND=IND+1;
        render_type(ts.types[i]);
        IND=IND-1;
        print(")");
        i=i+1;
    }
    IND=IND-1;
    print(")");
}

fn render_ast(ast:*AST) {
    i:int=0;
    while i < ast.defs_len {
        d:AST_Def = ast.defs[i];
        if d.kind == AST_DEF_FUN {render_fun_def(d.fun);}
        if d.kind == AST_DEF_CONST {render_const_def(d.global);}
        if d.kind == AST_DEF_VAR {render_var_def(d.global);}
        if d.kind == AST_DEF_TYPE {render_type_def(d.stru);}
        i=i+1;
    }
    println("");
}

////////////////////////////////////
// SYM                            //
////////////////////////////////////

const SYM_KIND_STACK:int     = 1;
const SYM_KIND_STACK_ARG:int = 2;
const SYM_KIND_CONST:int     = 3;
const SYM_KIND_VAR:int       = 4;
const SYM_KIND_FUN:int       = 5;

struct Symbol {
    t:Type;
    sizeb:int;
    kind:int;
    offset:int;
    def:AST_Stmt_Declare;
    fun:*AST_Def_Fun;
}
const SIZEOF_Symbol:int = 160;

struct SymT {
  symbols:*Symbol;
  len:int;
  cap:int;
}
const SIZEOF_SymT:int = 24;

struct SSSEntry {
  name:*char;
  name_len:int;
  sym_idx:int;
}
const SIZEOF_SSSEntry:int = 24;

struct SSSFrame {
  entries:*SSSEntry;
  sizeb:int;
  len:int;
  cap:int;
  sret_offset:int;
}
const SIZEOF_SSSFrame:int = 40;

struct ScopedSymbolStack {
  frames:*SSSFrame;
  len:int;
  cap:int;
}
const SIZEOF_ScopedSymbolStack:int = 40;

struct TypeTable {
  structs:*TypeStructDef;
  len:int;
  cap:int;
}
const SIZEOF_TypeTable:int = 24;

fn to_stack_size(size:int) int {
  // rounds up to multiples of 8
  return (size + 7) & ~7;
}

var TT:*TypeTable = 0;
var ST:*SymT = 0;
var SSS:*ScopedSymbolStack = 0;

fn size_of_type(t:Type) int {
    if t.kind == TYPE_KIND_STRUCT {
        if t.struct_name.sym_idx >= TT.len { error("struct idx out of range"); }
        return TT.structs[t.struct_name.sym_idx].sizeb;
    }
    if t.kind == TYPE_KIND_PTR { return 8; }
    if t.kind == TYPE_KIND_BASE {
        if t.base == TYPE_CHAR { return 1; }
        if t.base == TYPE_BOOL { return 1; }
        if t.base == TYPE_INT  { return 8; }
        if t.base == TYPE_VOID { error("void has no size"); }
    }
    error("UNIMPLEMENTED: type kind size");
    return 0;//unreachable
}

fn sym_add_type(ts:TypeStructDef) {
    if TT.len >= TT.cap {
        TT.cap = TT.cap * 2;
        TT.structs = realloc(TT.structs, TT.cap * SIZEOF_TypeStructDef);
    }
    ts.sizeb = -1; // mark it as unknown for now
    TT.structs[TT.len] = ts;
    TT.len = TT.len+1;
}

fn sym_search_type_idx(idx:int) TypeStructDef {
    return TT.structs[idx]; 
}

fn sym_search_type(name:*char, name_len:int) int {
    i:int = 0;
    while i < TT.len {
        t:TypeStructDef = TT.structs[i];
        if t.name_len == name_len && streq(name, t.name, name_len) {
            return i;
        }
        i=i+1;
    }
    error("couldn't find type");
    return 0;//unreachable
}

fn sym_compute_type_sizes() {
    n_finished:int = 0;
    last_round_total_finished:int = 0;
    while n_finished != TT.len {
        t_i:int = 0;
        // for (int t_i = 0; t_i < TT.len; t_i++) 
        while (t_i < TT.len) {
            if TT.structs[t_i].sizeb != -1 { continue; }
            size_accum:int = 0;
            fields_finished:int = 0;
            f_i:int = 0;
            while f_i < TT.structs[t_i].n_fields {
                t:Type = TT.structs[t_i].types[f_i];
                st:TypeStructDef;
                if t.kind == TYPE_KIND_PTR {
                    size_accum = size_accum+8;
                    fields_finished = fields_finished+1;
                }
                if t.kind == TYPE_KIND_BASE {
                    if t.base == TYPE_VOID { error("can't compute the size of void"); }
                    if t.base == TYPE_BOOL { size_accum = size_accum+1; }
                    if t.base == TYPE_INT { size_accum = size_accum+8; }
                    if t.base == TYPE_CHAR { size_accum = size_accum+1; }
                    fields_finished = fields_finished+1;
                }
                if t.kind == TYPE_KIND_STRUCT {
                    st = sym_search_type_idx(sym_search_type(
                        t.struct_name.name, t.struct_name.name_len));
                    if st.sizeb == -1 { f_i=f_i+1; continue; }
                    size_accum = size_accum+st.sizeb;
                    fields_finished = fields_finished+1;
                }
                f_i=f_i+1;
            }

            if fields_finished == TT.structs[t_i].n_fields {
                sizeb:int = (size_accum + 7) & ~7;
                print("computed size of struct '");
                write(TT.structs[t_i].name, TT.structs[t_i].name_len);
                print("': ");
                print(fmt_dec(size_accum));
                println("");
                n_finished=n_finished+1;
                TT.structs[t_i].sizeb = sizeb;
            }
            t_i=t_i+1;
        }
        if last_round_total_finished == n_finished {
            error("couldn't resolve type sizes, maybe you have recursive definitions?");
        }
        last_round_total_finished = n_finished;
    }
    println("Success computing type sizes");
}

fn sym_push_frame() {
    if SSS.len >= SSS.cap {
        SSS.cap = SSS.cap*2;
        SSS.frames = realloc(SSS.frames, SSS.cap * SIZEOF_SSSFrame);
    }
    new_frame:*SSSFrame = &SSS.frames[SSS.len];
    SSS.len = SSS.len+1;
    new_frame.cap = 16;
    new_frame.len = 0;
    new_frame.sret_offset = -1;
    if SSS.len == 1 {
        new_frame.sizeb = 0;
    }
    if SSS.len != 1 {
        new_frame.sizeb = SSS.frames[SSS.len - 2].sizeb;
    }
    new_frame.entries = alloc(new_frame.cap * SIZEOF_SSSEntry);
}

fn sym_pop_frame() {
    if SSS.len == 0 { error("can't pop from empty ScopedSymbolStack\n"); }
    SSS.len = SSS.len-1;
}

fn sym_init_tables() {
    ST = alloc(SIZEOF_SymT);
    ST.cap = 32;
    ST.len = 0;
    ST.symbols = alloc(ST.cap * SIZEOF_Symbol);

    TT = alloc(SIZEOF_TypeTable);
    TT.cap = 32;
    TT.len = 0;
    TT.structs = alloc(TT.cap * SIZEOF_TypeStructDef);

    SSS = alloc(SIZEOF_ScopedSymbolStack);
    SSS.cap = 32;
    SSS.len = 0;
    SSS.frames = alloc(SSS.cap * SIZEOF_SSSFrame);
}

fn new_sym() *Symbol {
    if ST.len >= ST.cap {
        ST.cap = ST.cap*2;
        ST.symbols = realloc(ST.symbols, ST.cap * SIZEOF_Symbol);
    }
    sym:*Symbol = &ST.symbols[ST.len];
    ST.len = ST.len + 1;
    return sym;
}

fn current_frame() *SSSFrame { 
    return &SSS.frames[SSS.len - 1]; 
}

fn current_function_frame() *SSSFrame {
    assert(SSS.len > 1);
    return &SSS.frames[1];
}

fn sym_get_sret_idx() int { 
    f:*SSSFrame = current_function_frame();
    return f.sret_offset; 
}

fn sym_set_sret_idx(sret:int) {
    f:*SSSFrame = current_function_frame();
    f.sret_offset = sret;
}

fn new_entry() *SSSEntry {
    f:*SSSFrame = current_frame();
    if f.len >= f.cap {
        f.cap = f.cap*2;
        f.entries = realloc(f.entries, f.cap * SIZEOF_SSSEntry);
    }
    e:*SSSEntry = &f.entries[f.len];
    f.len = f.len + 1;
    return e;
}

fn sym_fill_index_if_struct(t:*Type) {
    if t.kind == TYPE_KIND_BASE { return; }
    if t.kind ==  TYPE_KIND_STRUCT {
        t.struct_name.sym_idx = sym_search_type(t.struct_name.name, 
                                                t.struct_name.name_len);
        return;
    }
    if t.kind == TYPE_KIND_PTR {
        sym_fill_index_if_struct(t.ptr);
        return;
    }
}

fn sym_add_varconst(def:AST_Stmt_Declare, kind:int) int {
    idx:int = ST.len;
    sym:*Symbol = new_sym();
    sym_fill_index_if_struct(&def.t);
    sym.t = def.t;
    sym.kind = kind;
    sym.def = def;
    sym.sizeb = size_of_type(def.t);

    assert(SSS.len == 1);
    e:*SSSEntry = new_entry();
    e.name = def.var_name;
    e.name_len = def.var_name_len;
    e.sym_idx = idx;

    return idx;
}

fn sym_add_global_var(def:AST_Stmt_Declare) int {
  return sym_add_varconst(def, SYM_KIND_VAR);
}

fn sym_add_global_const(def:AST_Stmt_Declare) int {
  return sym_add_varconst(def, SYM_KIND_CONST);
}

fn sym_add_fun(fun:*AST_Def_Fun) int {
    idx:int = ST.len;
    sym:*Symbol = new_sym();
    sym.kind = SYM_KIND_FUN;
    sym.fun = fun;

    e:*SSSEntry = new_entry();
    e.name = fun.name;
    e.name_len = fun.name_len;
    e.sym_idx = idx;
    return idx;
}

fn sym_current_frame_size() int { 
    f:*SSSFrame = current_frame();
    return f.sizeb; 
}

fn sym_create_sym(t:Type, kind:int) int {
    idx:int = ST.len;
    sym:*Symbol = new_sym();
    sym_fill_index_if_struct(&t);
    sym.t = t;
    sym.kind = kind;
    sym.sizeb = size_of_type(t);

    assert(SSS.len > 1);
    ff:*SSSFrame = current_function_frame();
    ff.sizeb = ff.sizeb+to_stack_size(sym.sizeb);
    sym.offset = ff.sizeb;
    return idx;
}

fn sym_add_temporary(t:Type) int { 
    return sym_create_sym(t, SYM_KIND_STACK); 
}

fn sym_add_svar_arg(t:Type, name:*char, name_len:int) int {
    idx:int = ST.len;
    sym:*Symbol = new_sym();
    sym_fill_index_if_struct(&t);
    sym.t = t;
    sym.kind = SYM_KIND_STACK_ARG;
    sym.sizeb = 8; // arguments are always allocated as 8 bytes
    
    assert(SSS.len > 1);
    ff:*SSSFrame = current_function_frame();
    ff.sizeb = ff.sizeb+to_stack_size(sym.sizeb);
    sym.offset = ff.sizeb;
    
    e:*SSSEntry = new_entry();
    e.name = name;
    e.name_len = name_len;
    e.sym_idx = idx;
    return idx;
}

fn sym_add_svar(t:Type, name:*char, name_len:int) int {
    idx:int = sym_create_sym(t, SYM_KIND_STACK);
    e:*SSSEntry = new_entry();
    e.name = name;
    e.name_len = name_len;
    e.sym_idx = idx;
    return idx;
}

fn sym_search(idx:int) *Symbol { 
    return &ST.symbols[idx]; 
}

fn sym_stack_search(name:*char, name_len:int) int {
    i:int = SSS.len - 1;
    while i >= 0 {
        f:SSSFrame = SSS.frames[i];
        j:int = f.len -1;
        while j >= 0 {
            if name_len == f.entries[j].name_len &&
               streq(name, f.entries[j].name, name_len) {
                return f.entries[j].sym_idx;
            }
            j=j-1;
        }
        i=i-1;
    }
    error("Couldn't find symbol");
    return 0;//unreachable
}

fn sym_all() *SymT { return ST; }

////////////////////////////////////
// SEMANTIC ANALYSIS              //
////////////////////////////////////

fn tc_can_unify(from:Type, to:Type) bool {
  return size_of_type(from) == size_of_type(to);
}


fn tc_call(c:*AST_Expr_Call) Type {
    if c.is_syscall {
        i:int = 0;
        while i < c.args_len {
            tc_expr(&c.args[i]);
            i=i+1;
        }
        return ast_new_base_type(TYPE_INT);
    }
    assert(c.fun_expr.kind == AST_EXPR_VAR);
    fun_name:*char = c.fun_expr.varr.name;
    fun_name_len:int = c.fun_expr.varr.name_len;
    sym_idx:int = sym_stack_search(fun_name, fun_name_len);
    s:*Symbol = sym_search(sym_idx);
    c.fun_expr.varr.sym_idx = sym_idx;
    if s.kind != SYM_KIND_FUN { 
        println(fmt_dec(s.kind));
        error("symbol is not a function"); 
    }
    f:*AST_Def_Fun = s.fun;
    if c.args_len != f.num_args { error("function arg number mismatch"); }
    c.temporary_sym_idxs = alloc(c.args_len * 8);
    i:int = 0;
    while i < c.args_len {
        arg:*AST_Expr = &c.args[i];
        tc_expr(arg);
        if arg.ty.kind == TYPE_KIND_STRUCT {
          c.temporary_sym_idxs[i] = sym_add_temporary(arg.ty);
        } 
        if arg.ty.kind != TYPE_KIND_STRUCT {
          c.temporary_sym_idxs[i] = -1;
        }

        sym_fill_index_if_struct(&f.arg_types[i]);
        sym_fill_index_if_struct(&c.args[i].ty);
        if !tc_can_unify(f.arg_types[i], c.args[i].ty) { error("Expected argument type mismatch"); }
        c.args[i].ty = f.arg_types[i];
        i=i+1;
    }

    if f.return_type.kind == TYPE_KIND_STRUCT {
        c.temporary_sret_sym_idx = sym_add_temporary(f.return_type);
    } 
    if f.return_type.kind != TYPE_KIND_STRUCT {
        c.temporary_sret_sym_idx = -1;
    }

    return f.return_type;
}

fn tc_access(access:*AST_Expr_Binop) Type {
    tc_expr(access.left);
    valid_left:bool = (access.left.kind == AST_EXPR_BINOP &&
                        (access.left.binop.op == TOK_PERIOD || access.left.binop.op == TOK_LSQBR))
                      || (access.left.kind == AST_EXPR_VAR);
    if !valid_left { error("expression of some kind is not accessible"); }

    left_t:Type = access.left.ty;
    while left_t.kind == TYPE_KIND_PTR {
        left_t = *left_t.ptr; // auto derreference
    }

    if (left_t.kind != TYPE_KIND_STRUCT) {
        error("can't access type that is not a struct");
    }
    ts:TypeStructDef = sym_search_type_idx(left_t.struct_name.sym_idx);

    if (access.right.kind != AST_EXPR_VAR) {
        error("invalid access expression");
    }
    field:*char = access.right.varr.name;
    field_len:int = access.right.varr.name_len;

    accum_offset:int = 0;
    i:int = 0;
    while (i < ts.n_fields) {
        sym_fill_index_if_struct(&ts.types[i]);
        if !(field_len == ts.field_name_lens[i] &&
              streq(ts.field_names[i], field, field_len)) {
            accum_offset = accum_offset+size_of_type(ts.types[i]);
            i = i+1;
            continue;
        }
        access.offsetb = accum_offset;
        return ts.types[i];
    }
    error("type doesn't have that field");
    nop:Type; // unreachable
    return nop;
}

fn tc_subscript(binop:*AST_Expr_Binop) Type {
    assert(binop.op == TOK_LSQBR);
    tc_expr(binop.left);
    left_t:Type = binop.left.ty;

    if (left_t.kind != TYPE_KIND_PTR) {
        error("can't subscript non pointer like an array");
    }

    tc_expr(binop.right);
    if (binop.right.ty.kind != TYPE_KIND_BASE ||
      binop.right.ty.base != TYPE_INT) {
        error("can't subscript array with non int expression");
    }
    return *left_t.ptr;
}

fn tc_binop(binop:*AST_Expr_Binop) Type {
    l:*AST_Expr = binop.left;
    r:*AST_Expr = binop.right;
    if binop.op == TOK_EQUALSEQUALS 
    || binop.op == TOK_BANGEQUALS {
        tc_expr(l);
        tc_expr(r);
        if (!tc_can_unify(l.ty, r.ty) && !tc_can_unify(r.ty, l.ty)) {
            error("can't compare different types with == or !=");
        }
        return ast_new_base_type(TYPE_BOOL);
    }
    if binop.op == TOK_GT 
    || binop.op == TOK_GTE
    || binop.op == TOK_LT
    || binop.op == TOK_LTE {
        tc_expr(l);
        tc_expr(r);
        if (!tc_can_unify(l.ty, r.ty)) {
            error("can't compare different typed sizes types with op");
        }
        return ast_new_base_type(TYPE_BOOL);
    }
    if binop.op == TOK_AND 
    || binop.op == TOK_OR {
        tc_expr(l);
        tc_expr(r);
        if (!tc_can_unify(l.ty, ast_new_base_type(TYPE_BOOL)) ||
            !tc_can_unify(r.ty, ast_new_base_type(TYPE_BOOL))) {
            error("can't perform op on non booleans");
        }
        return ast_new_base_type(TYPE_BOOL);
    }
    if binop.op == TOK_PLUS
    || binop.op == TOK_MINUS
    || binop.op == TOK_ASTERISK
    || binop.op == TOK_PERCENT
    || binop.op == TOK_SLASH
    || binop.op == TOK_SHIFT_LEFT
    || binop.op == TOK_SHIFT_RIGHT
    || binop.op == TOK_BIT_OR
    || binop.op == TOK_AMPERSAND {
        tc_expr(l);
        tc_expr(r);
        if (!tc_can_unify(l.ty, ast_new_base_type(TYPE_INT)) ||
            !tc_can_unify(r.ty, ast_new_base_type(TYPE_INT))) {
            error("can't perform arithmetic op on non ints");
        }
        return l.ty;
    }
    if binop.op == TOK_PERIOD { return tc_access(binop); }
    if binop.op == TOK_LSQBR { return tc_subscript(binop); }
    error("invalid operator");
    nop:Type;//unreachable
    return nop;
}

fn tc_unop(unop:*AST_Expr_Unop) Type {
    tc_expr(unop.expr);
    if unop.op == TOK_MINUS
    || unop.op == TOK_PLUS {
        if (unop.expr.ty.kind != TYPE_KIND_BASE ||
            unop.expr.ty.base != TYPE_INT) {
            error("invalid unop");
        }
        return unop.expr.ty;
    }
    if unop.op == TOK_AMPERSAND {
        return ast_new_ptr_type(unop.expr.ty);
    }
    if unop.op == TOK_BANG
    || unop.op == TOK_TILDE {
        return unop.expr.ty;
    }
    if unop.op == TOK_ASTERISK {
        if (unop.expr.ty.kind != TYPE_KIND_PTR) {
            error("can't derreference non-pointer type");
        }
        return *unop.expr.ty.ptr;
    }
    error("unimplemented unop");
    nop:Type;//unreachable
    return nop;
}

fn tc_var(varr:*AST_Expr_Var) Type {
    sym_idx:int = sym_stack_search(varr.name, varr.name_len);
    sym:*Symbol = sym_search(sym_idx);
    varr.sym_idx = sym_idx;
    return sym.t;
}

fn tc_expr(expr:*AST_Expr) {
    if expr.kind == AST_EXPR_LIT_INT {
        expr.ty = ast_new_base_type(TYPE_INT);
        return;
    }
    if expr.kind == AST_EXPR_LIT_CHAR {
        expr.ty = ast_new_base_type(TYPE_CHAR);
        return;
    }
    if expr.kind == AST_EXPR_LIT_BOOL {
        expr.ty = ast_new_base_type(TYPE_BOOL);
        return;
    }
    if expr.kind == AST_EXPR_LIT_STRING {
        expr.ty = ast_new_ptr_type(ast_new_base_type(TYPE_CHAR));
        return;
    }
    if expr.kind == AST_EXPR_VAR {
        expr.ty = tc_var(&expr.varr);
        return;
    }
    if expr.kind == AST_EXPR_UNOP {
        expr.ty = tc_unop(&expr.unop);
        return;
    }
    if expr.kind == AST_EXPR_BINOP {
        expr.ty = tc_binop(&expr.binop);
        return;
    }
    if expr.kind == AST_EXPR_CALL {
        expr.ty = tc_call(&expr.call);
        return;
    }
    print("kind: ");
    println(fmt_hex(expr.kind));
    error("unimplemented expr kind");
}

fn tc_stmt(stmt:*AST_Stmt, ret:Type) {
    decl:*AST_Stmt_Declare;
    if stmt.kind == AST_STMT_DEFINE {
        decl = &stmt.define;
        sym_fill_index_if_struct(&decl.t);
        decl.sym_idx = sym_add_svar(decl.t, decl.var_name, decl.var_name_len);
        if (decl.expr == 0) { return; }
        tc_expr(decl.expr);
        sym_fill_index_if_struct(&decl.expr.ty);

        if (!tc_can_unify(decl.expr.ty, decl.t)) {
            error("expected type X, but found Y in definition");
        }
        return;
    }
    if stmt.kind == AST_STMT_ASSIGN {
        tc_expr(&stmt.assign.lvalue);
        lvalue:*AST_Expr = &stmt.assign.lvalue;

        valid:bool = false;
        if lvalue.kind == AST_EXPR_VAR {
            sym:*Symbol = sym_search(lvalue.varr.sym_idx);
            if (sym.kind == SYM_KIND_CONST) {
                error("Can't write to const");
            }
            stmt.assign.sym_idx = lvalue.varr.sym_idx;
            valid = true;
        }
        if lvalue.kind == AST_EXPR_BINOP {
            if (lvalue.binop.op == TOK_PERIOD) {
                lvalue.ty = tc_access(&lvalue.binop);
                valid = true;
            }
            if (lvalue.binop.op == TOK_LSQBR) {
                lvalue.ty = tc_subscript(&lvalue.binop);
                valid = true;
            }
            if !valid { error("Expression is not assignable"); }
        }
        if lvalue.kind == AST_EXPR_UNOP {
            if (lvalue.unop.op != TOK_ASTERISK) {
                error("Expression is not assignable");
            }
            valid = true;
        }
        if !valid { error("Left expression is not assignable"); }

        rvalue:*AST_Expr = &stmt.assign.rvalue;
        tc_expr(rvalue);

        sym_fill_index_if_struct(&lvalue.ty);
        sym_fill_index_if_struct(&rvalue.ty);

        if (!tc_can_unify(lvalue.ty, rvalue.ty)) {
            error("can't assign expression of type X, to destination of type Y");
        }
        stmt.assign.t = lvalue.ty;
        return;
    }
    if stmt.kind == AST_STMT_IF {
        sym_push_frame();
        tc_expr(stmt.iff.cond);
        if (!tc_can_unify(stmt.iff.cond.ty, ast_new_base_type(TYPE_BOOL))) {
            error("Expected bool in if condition, found other");
        }
        tc_block(stmt.iff.block, ret);
        sym_pop_frame();
        return;
    }
    if stmt.kind == AST_STMT_WHILE {
        sym_push_frame();
        tc_expr(stmt.whilee.cond);
        if (!tc_can_unify(stmt.whilee.cond.ty,
                        ast_new_base_type(TYPE_BOOL))) {
            error("Expected bool in while condition, found other");
        }
        tc_block(stmt.whilee.block, ret);
        sym_pop_frame();
        return;
    }
    if stmt.kind == AST_STMT_RETURN {
        if (ret.kind == TYPE_KIND_BASE && ret.base == TYPE_VOID &&
            stmt.returnn.expr != 0) {
            error("Expected void return");
        }

        // -1 for non structs
        stmt.returnn.sret_idx = sym_get_sret_idx();

        if (stmt.returnn.expr != 0) {
            tc_expr(stmt.returnn.expr);
            if (!tc_can_unify(stmt.returnn.expr.ty, ret)) {
                error("must return type X, but returned Y");
            }
        }
        return;
    }
    if stmt.kind == AST_STMT_RAW_EXPR {
        tc_expr(&stmt.raw_expr);
    }
    // if stmt.kind == AST_STMT_BREAK
    // || stmt.kind == AST_STMT_CONTINUE {
    // }
}

fn tc_block(b:*Block, ret:Type) {
    i:int = 0;
    while i < b.stmts_len {
        tc_stmt(&b.stmts[i], ret);
        i=i+1;
    }
}

fn tc_fun(fun:*AST_Def_Fun) {
    sym_push_frame();
    if (fun.return_type.kind == TYPE_KIND_STRUCT) {
        sym_fill_index_if_struct(&fun.return_type);
        sret_idx:int = sym_add_temporary(ast_new_ptr_type(ast_new_base_type(TYPE_VOID)));
        sym_set_sret_idx(sret_idx);
        fun.sret_sym_idx = sret_idx;
    }
    i:int = 0;
    while i < fun.num_args {
        sym_fill_index_if_struct(&fun.arg_types[i]);
        fun.arg_sym_idxs[i] = sym_add_svar_arg(
            fun.arg_types[i], fun.arg_names[i], fun.arg_name_lens[i]);
        i=i+1;
    }

    tc_block(&fun.block, fun.return_type);
    fun.locals_stack_size = sym_current_frame_size();

    b:*Block = &fun.block;

    // insert last "return;" for void functions
    if (fun.return_type.kind == TYPE_KIND_BASE
        && fun.return_type.base == TYPE_VOID
        && b.stmts[b.stmts_len - 1].kind != AST_STMT_RETURN) {
        ret_stmt:AST_Stmt;
        ret_stmt.kind = AST_STMT_RETURN;
        ret_stmt.returnn.expr = 0;
        if (b.stmt_cap <= b.stmts_len) {
            b.stmt_cap = b.stmt_cap + 1;
            b.stmts = realloc(b.stmts, b.stmt_cap * SIZEOF_AST_Stmt);
        }
        b.stmts[b.stmts_len] = ret_stmt;
        b.stmts_len = b.stmts_len + 1;
    }

    // check that some last return exists
    if (b.stmts[b.stmts_len - 1].kind != AST_STMT_RETURN) {
        error("function without return");
    }
    sym_pop_frame();
}

fn tc_def(def:*AST_Def) {
  if def.kind == AST_DEF_CONST
  || def.kind == AST_DEF_VAR
  || def.kind == AST_DEF_TYPE {
        return;
  }
  if def.kind == AST_DEF_FUN {
    tc_fun(&def.fun);
    return;
  }
}

fn define_top_level(ast:*AST) {
    i:int = 0;
    while i < ast.defs_len {
        d:*AST_Def = &ast.defs[i];
        if d.kind == AST_DEF_FUN { sym_add_fun(&d.fun); }
        if d.kind == AST_DEF_TYPE { sym_add_type(d.stru); }
        if d.kind == AST_DEF_VAR {
            tc_expr(d.global.expr);
            sym_add_global_var(d.global);
        }
        if d.kind == AST_DEF_CONST {
            tc_expr(d.global.expr);
            sym_add_global_const(d.global);
        }
        i=i+1;
    }
}

fn type_check(ast:*AST) {
    sym_init_tables();
    sym_push_frame();
    define_top_level(ast);
    sym_compute_type_sizes();
    i:int = 0;
    while i < ast.defs_len {
        tc_def(&ast.defs[i]);
        i=i+1;
    }
    sym_pop_frame();
}

